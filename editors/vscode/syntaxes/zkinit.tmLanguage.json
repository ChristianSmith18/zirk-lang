{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zirk Project Configuration",
  "scopeName": "source.zirk-init",
  "patterns": [
    { "include": "#comments" },
    { "include": "#sections" },
    { "include": "#keys" },
    { "include": "#capabilities" },
    { "include": "#builtin-types" },
    { "include": "#custom-types" },
    { "include": "#options" },
    { "include": "#booleans" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.zirk-init", "match": "//.*$" },
        { "name": "comment.line.number-sign.zirk-init", "match": "#.*$" }
      ]
    },
    "sections": {
      "patterns": [
        {
          "name": "keyword.control.section.zirk-init",
          "match": "(?m)^\\s*(project|build_targets|dependencies|dev_dependencies|globals|requires)\\b"
        },
        {
          "name": "keyword.control.section.zirk-init",
          "match": "(?m)^\\s*(source)\\s+(?=\")"
        }
      ]
    },
    "keys": {
      "name": "variable.other.key.zirk-init",
      "match": "\\b(name|version|type|entry|root|authors|description|license|default|from|readonly|rev|integrity|path|registry|git|source|url)\\b(?=\\s*:)"
    },
    "capabilities": {
      "name": "support.constant.capability.zirk-init",
      "match": "\\b(filesystem\\.(read|write)|network\\.(connect|listen|inspect_interfaces)|network\\.udp\\.(send|listen)|network\\.local\\.(connect|listen)|environment\\.(read|list_names)|secrets\\.read|process\\.(execute|shell))\\b"
    },
    "builtin-types": {
      "patterns": [
        {
          "name": "storage.type.builtin.zirk-init",
          "match": "\\b(Boolean|Byte|Char|Decimal|Date|DateTime|Duration|Float(16|32|64|128)?|Int(8|16|32|64|128)|String|Time|UInt(8|16|32|64|128)|Void)\\b"
        }
      ]
    },
    "custom-types": {
      "name": "entity.name.type.custom.zirk-init",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "options": {
      "patterns": [
        {
          "name": "constant.language.option.zirk-init",
          "match": "\\b(application|package)\\b"
        },
        {
          "name": "constant.language.build-target.zirk-init",
          "match": "\\b(x86_64|aarch64)-(windows|linux|macos)\\b"
        }
      ]
    },
    "booleans": {
      "name": "constant.language.boolean.zirk-init",
      "match": "\\b(true|false)\\b"
    },
    "strings": {
      "name": "string.quoted.double.zirk-init",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.zirk-init" } },
      "end": "\"|$",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.zirk-init" } },
      "patterns": [
        { "name": "constant.language.build-target.zirk-init", "match": "\\b(x86_64|aarch64)-(windows|linux|macos)\\b" },
        { "name": "constant.other.version.zirk-init", "match": "\\b[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?\\b" },
        { "name": "constant.character.escape.zirk-init", "match": "\\\\." }
      ]
    },
    "numbers": {
      "name": "constant.numeric.zirk-init",
      "match": "(?<![A-Za-z0-9_])[+-]?[0-9]+(\\.[0-9]+)?(?![A-Za-z0-9_])"
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.section.braces.zirk-init", "match": "[{}\\[\\]]" },
        { "name": "punctuation.separator.key-value.zirk-init", "match": ":" },
        { "name": "punctuation.terminator.zirk-init", "match": ";|," }
      ]
    }
  }
}
