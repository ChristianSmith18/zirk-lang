{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zirk",
  "scopeName": "source.zirk",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#durations" },
    { "include": "#numbers" },
    { "include": "#decorators" },
    { "include": "#function-declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#builtins" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zirk",
          "match": "//.*$"
        },
        {
          "name": "comment.block.zirk",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zirk",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zirk",
              "match": "\\\\(n|t|r|\\\\|\")"
            },
            {
              "name": "meta.embedded.line-interpolation.zirk",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.embedded.begin.zirk" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.embedded.end.zirk" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "durations": {
      "patterns": [
        {
          "name": "constant.numeric.duration.zirk",
          "match": "\\b[0-9]+(_[0-9]+)*(ms|s|m|h)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.zirk",
          "match": "\\b0x[0-9a-fA-F]+(_[0-9a-fA-F]+)*\\b"
        },
        {
          "name": "constant.numeric.octal.zirk",
          "match": "\\b0o[0-7]+(_[0-7]+)*\\b"
        },
        {
          "name": "constant.numeric.binary.zirk",
          "match": "\\b0b[01]+(_[01]+)*\\b"
        },
        {
          "name": "constant.numeric.float.zirk",
          "match": "\\b[0-9]+(_[0-9]+)*\\.[0-9]+(_[0-9]+)*(e[+-]?[0-9]+)?\\b|\\b[0-9]+(_[0-9]+)*e[+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.zirk",
          "match": "\\b[0-9]+(_[0-9]+)*\\b"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.zirk",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.function.zirk" },
            "2": { "name": "entity.name.function.zirk" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zirk",
          "match": "\\b(if|else|return|match|with|default|try|catch|finally|loop|while|for|in|break|continue|task|await|parallel|thread)\\b"
        },
        {
          "name": "storage.modifier.zirk",
          "match": "\\b(mut|inmut::strict|inmut|sync|public|private|protected|abstract|unsafe|share|import|from|use|type|class|construct|implements|extends|interface|trait|record|enum|gen|dec)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.zirk",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "variable.language.zirk",
          "match": "\\b(this)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.zirk",
          "match": "\\b(Int8|Int16|Int32|Int64|Int128|Int|Integer|UInt8|UInt16|UInt32|UInt64|UInt128|Decimal16|Decimal32|Decimal64|Decimal128|Dec|Decimal|Boolean|Char|String|Void|Never|Null|Object|List|Map|Set|Range|Pointer)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cast.zirk",
          "match": "\\b(as|is)\\b"
        },
        {
          "name": "keyword.operator.zirk",
          "match": "\\+\\+|--|\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|=>|\\?\\?|\\?\\.|\\|>|&&|\\|\\||\\+|-|\\*|/|%|<|>|=|!|\\?|:|&"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.variable.zirk",
          "match": "\\b(stdin|stdout|stderr)\\b"
        },
        {
          "name": "support.function.zirk",
          "match": "\\b(print|println|to_string|assert|equal)\\b"
        }
      ]
    }
  }
}
