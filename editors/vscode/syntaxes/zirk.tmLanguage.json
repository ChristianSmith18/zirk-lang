{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zirk",
  "scopeName": "source.zirk",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#durations"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#member-markers"
    },
    {
      "include": "#type-declarations"
    },
    {
      "include": "#function-declarations"
    },
    {
      "include": "#method-declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#fixed-array-types"
    },
    {
      "include": "#types"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#named-arguments"
    },
    {
      "include": "#range-braced-operands"
    },
    {
      "include": "#range-operators"
    },
    {
      "include": "#brackets"
    },
    {
      "include": "#key-value-separators"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zirk",
          "match": "//.*$"
        },
        {
          "name": "comment.block.zirk",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "imports": {
      "begin": "\\bimport\\b",
      "end": ";",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.import.zirk"
        }
      },
      "patterns": [
        {
          "name": "keyword.control.import.zirk",
          "match": "\\bfrom\\b"
        },
        {
          "name": "meta.import.items.zirk",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.braces.zirk"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.braces.zirk"
            }
          },
          "patterns": [
            {
              "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(->)\\s*([A-Z][A-Za-z0-9_]*)\\b",
              "captures": {
                "1": {
                  "name": "comment.line.marker.zirk"
                },
                "2": {
                  "name": "keyword.operator.alias.zirk"
                },
                "3": {
                  "name": "entity.name.type.import.alias.zirk"
                }
              }
            },
            {
              "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(->)\\s*([a-z_][A-Za-z0-9_]*)\\b",
              "captures": {
                "1": {
                  "name": "comment.line.marker.zirk"
                },
                "2": {
                  "name": "keyword.operator.alias.zirk"
                },
                "3": {
                  "name": "variable.other.import.alias.zirk"
                }
              }
            },
            {
              "name": "entity.name.type.imported.zirk",
              "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "variable.other.imported.zirk",
              "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.zirk",
              "match": ","
            }
          ]
        },
        {
          "name": "support.module.standard.zirk",
          "begin": "\\bstd\\b",
          "end": "(?=;)",
          "patterns": [
            {
              "name": "punctuation.separator.module-path.zirk",
              "match": "::"
            }
          ]
        },
        {
          "name": "support.module.external.zirk",
          "match": "\\b[a-z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*(?:::[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)?\\b"
        },
        {
          "include": "#strings"
        },
        {
          "name": "punctuation.section.braces.zirk",
          "match": "\\{|\\}"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.zirk",
          "begin": "'''",
          "end": "'''",
          "patterns": [
            {
              "name": "constant.character.escape.zirk",
              "match": "\\\\(n|t|r|0|\\\\|'|\\{|\\})"
            },
            {
              "name": "source.zirk",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.begin.zirk"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.end.zirk"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.regexp.zirk",
          "begin": "re'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.zirk",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.character.zirk",
          "match": "'([^'\\\\]|\\\\(n|t|r|\\\\|'))'"
        },
        {
          "name": "string.quoted.double.zirk",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zirk",
              "match": "\\\\(n|t|r|0|\\\\|\"|\\{|\\})"
            },
            {
              "name": "source.zirk",
              "begin": "(?<!\\\\)\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.begin.zirk"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.end.zirk"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "durations": {
      "patterns": [
        {
          "name": "constant.numeric.duration.zirk",
          "match": "\\b[0-9]+(_[0-9]+)*(\\.[0-9]+(_[0-9]+)*)?([eE][+-]?[0-9]+(_[0-9]+)*)?(ns|us|ms|s|m|h|d|w)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.zirk",
          "match": "\\b0[xX][0-9a-fA-F]+(_[0-9a-fA-F]+)*\\b"
        },
        {
          "name": "constant.numeric.binary.zirk",
          "match": "\\b0[bB][01]+(_[01]+)*\\b"
        },
        {
          "name": "constant.numeric.float.zirk",
          "match": "\\b[0-9]+(_[0-9]+)*\\.[0-9]+(_[0-9]+)*([eE][+-]?[0-9]+(_[0-9]+)*)?(f(16|32|64|128)?)?\\b|\\b[0-9]+(_[0-9]+)*[eE][+-]?[0-9]+(_[0-9]+)*(f(16|32|64|128)?)?\\b|\\b[0-9]+(_[0-9]+)*f(16|32|64|128)?\\b"
        },
        {
          "name": "constant.numeric.integer.zirk",
          "match": "\\b[0-9]+(_[0-9]+)*\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.zirk"
        }
      ]
    },
    "named-arguments": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?=\\s*[,)])",
          "captures": {
            "1": {
              "name": "variable.parameter.zirk"
            },
            "2": {
              "name": "punctuation.separator.key-value.zirk"
            }
          }
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.zirk",
          "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.decorator.zirk"
            },
            "2": {
              "name": "entity.name.function.decorator.zirk"
            }
          }
        }
      ]
    },
    "member-markers": {
      "patterns": [
        {
          "name": "comment.line.marker.zirk",
          "match": "(#)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.marker.zirk"
            },
            "2": {
              "name": "comment.line.marker.zirk"
            }
          }
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "match": "\\b(class|contract|trait|enum|extends|implements)\\s+([A-Z][a-zA-Z0-9_]*(\\.[A-Z][a-zA-Z0-9_]*)*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.zirk"
            },
            "2": {
              "name": "entity.name.class.zirk"
            }
          }
        }
      ]
    },
    "method-declarations": {
      "patterns": [
        {
          "match": "\\b(?!fn|construct|if|else|match|while|for|return|in|do|loop|catch|throw|throws|select|await|task|try\\b)([a-z_][a-zA-Z0-9_]*)\\s*(?=\\([^()]*\\)\\s*:)",
          "captures": {
            "1": {
              "name": "entity.name.function.zirk"
            }
          }
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(fn\\s+dec|fn|gen)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.function.zirk"
            },
            "2": {
              "name": "entity.name.function.zirk"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zirk",
          "match": "\\b(if|else|match|with|for|in|while|do|loop|try|catch|finally|throws|task|await|select|parallel|thread|during|requires|permissions|scope|shield|after|cancelled|before|default|timeout|cancellation|from)\\b"
        },
        {
          "name": "keyword.control.exit.zirk",
          "match": "\\b(return|break|continue|throw|yield)\\b"
        },
        {
          "name": "storage.modifier.mutability.zirk",
          "match": "\\b(mut|inmut::strict|inmut|strict|sync|share)\\b"
        },
        {
          "name": "storage.modifier.zirk",
          "match": "\\b(public|private|protected|abstract|final|inner|static|unsafe|repeatable|dec|commit|decorators|attribute|function|method|parameter|override)\\b"
        },
        {
          "name": "keyword.declaration.zirk",
          "match": "\\b(import|use|package|mod|type|class|construct|contract|implements|extends|interface|trait|record|enum|gen|fn)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.zirk",
          "match": "\\b(true|false|null|Err|Some|None)\\b"
        },
        {
          "name": "constant.language.result-success.zirk",
          "match": "\\bOk\\b"
        },
        {
          "name": "constant.language.result-error.zirk",
          "match": "\\bError\\b"
        },
        {
          "name": "variable.language.zirk",
          "match": "\\b(this|outer|super)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.zirk",
          "match": "\\b(Int8|Int16|Int32|Int64|Int128|Int|Integer|UInt8|UInt16|UInt32|UInt64|UInt128|UInt|Byte|Float16|Float32|Float64|Float128|Float|Decimal|Dec|Boolean|Char|String|Date|Time|DateTime|Instant|ZonedDateTime|TimeZone|Duration|Period|Regex|Array|List|Set|Map|Range|Function|Fn|Tuple|Weak|Pointer|NativeSlice|NativeSliceMut|Task|TaskSettlement|Channel|Thread|Mutex|RwLock|Semaphore|Barrier|Once|Atomic|Null|Void|Never|Object|Dynamic|Result|Option|Throwable)\\b"
        },
        {
          "name": "entity.name.type.zirk",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "fixed-array-types": {
      "patterns": [
        {
          "match": "\\b([A-Z][a-zA-Z0-9_]*(?:\\s*<[^>]+>)?)(\\s*)(\\[)(\\s*)([0-9]+(?:_[0-9]+)*)(\\s*)(\\])",
          "captures": {
            "1": {
              "name": "storage.type.zirk"
            },
            "3": {
              "name": "punctuation.section.array.begin.zirk"
            },
            "5": {
              "name": "constant.numeric.integer.zirk"
            },
            "7": {
              "name": "punctuation.section.array.end.zirk"
            }
          }
        }
      ]
    },
    "range-operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.zirk",
          "match": "\\.\\.=?"
        }
      ]
    },
    "range-braced-operands": {
      "name": "meta.embedded.range-operand.zirk",
      "begin": "(?=\\{[^{}\\r\\n]*\\}\\s*\\.\\.=?)\\{|(?:(?<=\\.\\.)|(?<=\\.\\.=)|(?<=:))\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.zirk"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.zirk"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "match": "(\\[)|(\\])",
          "captures": {
            "1": {
              "name": "punctuation.section.brackets.begin.zirk"
            },
            "2": {
              "name": "punctuation.section.brackets.end.zirk"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.zirk",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.cast.zirk",
          "match": "\\b(is|as)\\b"
        },
        {
          "name": "keyword.operator.zirk",
          "match": "\\+\\+|--|\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|=>|->|\\?\\?|\\?\\.|\\*\\*|\\+|-|\\*|/|%|<|>|=|!|\\?|&|\\||\\^|~"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.variable.zirk",
          "match": "\\b(stdin|stdout|stderr)\\b"
        },
        {
          "name": "support.function.zirk",
          "match": "\\b(print|println|to_string|assert|equal|expect|fatalError)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.zirk",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "key-value-separators": {
      "name": "punctuation.separator.key-value.zirk",
      "match": ":"
    }
  }
}
