{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zirk",
  "scopeName": "source.zirk",
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#strings" },
    { "include": "#durations" },
    { "include": "#numbers" },
    { "include": "#decorators" },
    { "include": "#member-markers" },
    { "include": "#type-declarations" },
    { "include": "#function-declarations" },
    { "include": "#method-declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#function-calls" },
    { "include": "#named-arguments" },
    { "include": "#operators" },
    { "include": "#builtins" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zirk",
          "match": "//.*$"
        },
        {
          "name": "comment.block.zirk",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "imports": {
      "begin": "\\bimport\\b",
      "end": ";",
      "beginCaptures": {
        "0": { "name": "keyword.control.import.zirk" }
      },
      "patterns": [
        {
          "name": "keyword.control.import.zirk",
          "match": "\\bfrom\\b"
        },
        {
          "name": "support.class.zirk",
          "match": "\\bstd\\.[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*\\b"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(->)\\s*([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "comment.line.marker.zirk" },
            "2": { "name": "keyword.operator.alias.zirk" },
            "3": { "name": "entity.name.type.zirk" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(->)\\s*([a-z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "comment.line.marker.zirk" },
            "2": { "name": "keyword.operator.alias.zirk" },
            "3": { "name": "variable.other.readwrite.zirk" }
          }
        },
        {
          "name": "keyword.operator.alias.zirk",
          "match": "->"
        },
        {
          "name": "entity.name.type.zirk",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b"
        },
        {
          "name": "variable.other.readwrite.zirk",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\b"
        },
        {
          "include": "#strings"
        },
        {
          "name": "punctuation.section.braces.zirk",
          "match": "\\{|\\}"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.regexp.zirk",
          "begin": "re'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.zirk",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.character.zirk",
          "match": "'([^'\\\\]|\\\\(n|t|r|\\\\|'))'"
        },
        {
          "name": "string.quoted.double.zirk",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zirk",
              "match": "\\\\(n|t|r|\\\\|\"|:)"
            },
            {
              "match": "(?<!\\\\)(:)([a-zA-Z_][a-zA-Z0-9_]*|[0-9]+)(?:(\\|)([a-zA-Z0-9_\\-\\.\\#\\*\\+\\%]+))?",
              "captures": {
                "1": { "name": "punctuation.definition.placeholder.zirk" },
                "2": { "name": "variable.other.placeholder.zirk" },
                "3": { "name": "punctuation.separator.placeholder.zirk" },
                "4": { "name": "constant.other.format-specifier.zirk" }
              }
            },
            {
              "name": "source.zirk",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.embedded.begin.zirk" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.embedded.end.zirk" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "durations": {
      "patterns": [
        {
          "name": "constant.numeric.duration.zirk",
          "match": "\\b[0-9]+(_[0-9]+)*(ms|s|m|h)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.zirk",
          "match": "\\b0x[0-9a-fA-F]+(_[0-9a-fA-F]+)*\\b"
        },
        {
          "name": "constant.numeric.octal.zirk",
          "match": "\\b0o[0-7]+(_[0-7]+)*\\b"
        },
        {
          "name": "constant.numeric.binary.zirk",
          "match": "\\b0b[01]+(_[01]+)*\\b"
        },
        {
          "name": "constant.numeric.float.zirk",
          "match": "\\b[0-9]+(_[0-9]+)*\\.[0-9]+(_[0-9]+)*(e[+-]?[0-9]+)?(f(16|32|64|128)?)?\\b|\\b[0-9]+(_[0-9]+)*e[+-]?[0-9]+(f(16|32|64|128)?)?\\b"
        },
        {
          "name": "constant.numeric.integer.zirk",
          "match": "\\b[0-9]+(_[0-9]+)*\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.zirk"
        }
      ]
    },
    "named-arguments": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?=\\s*[,)])",
          "captures": {
            "1": { "name": "variable.parameter.zirk" },
            "2": { "name": "punctuation.separator.key-value.zirk" }
          }
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.zirk",
          "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.decorator.zirk" },
            "2": { "name": "entity.name.function.decorator.zirk" }
          }
        }
      ]
    },
    "member-markers": {
      "patterns": [
        {
          "name": "comment.line.marker.zirk",
          "match": "(#)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.marker.zirk" },
            "2": { "name": "comment.line.marker.zirk" }
          }
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "match": "\\b(class|interface|trait|record|enum|extends|implements)\\s+([A-Z][a-zA-Z0-9_]*(\\.[A-Z][a-zA-Z0-9_]*)*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.zirk" },
            "2": { "name": "entity.name.class.zirk" }
          }
        }
      ]
    },
    "method-declarations": {
      "patterns": [
        {
          "match": "\\b(?!fn|construct|if|else|match|while|for|return|in|do|loop|catch|throw|throws|select|await|task|try\\b)([a-z_][a-zA-Z0-9_]*)\\s*(?=\\([^()]*\\)\\s*:)",
          "captures": {
            "1": { "name": "entity.name.function.zirk" }
          }
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(fn\\s+dec|fn|gen)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.function.zirk" },
            "2": { "name": "entity.name.function.zirk" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zirk",
          "match": "\\b(if|else|match|with|for|in|while|do|loop|try|catch|finally|throws|task|await|select|parallel|thread|during|requires|permissions|scope|shield|after|cancelled|before|default|timeout|cancellation|from)\\b"
        },
        {
          "name": "keyword.control.exit.zirk",
          "match": "\\b(return|break|continue|throw|yield)\\b"
        },
        {
          "name": "storage.modifier.mutability.zirk",
          "match": "\\b(mut|inmut::strict|inmut|strict|sync|share)\\b"
        },
        {
          "name": "storage.modifier.zirk",
          "match": "\\b(public|private|protected|abstract|final|inner|static|unsafe|repeatable|dec|commit|decorators|attribute|function|method|parameter|override)\\b"
        },
        {
          "name": "keyword.declaration.zirk",
          "match": "\\b(import|use|type|class|construct|implements|extends|interface|trait|record|enum|gen|fn)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.zirk",
          "match": "\\b(true|false|null|Ok|Err|Some|None)\\b"
        },
        {
          "name": "variable.language.zirk",
          "match": "\\b(this|outer|super)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.zirk",
          "match": "\\b(Int8|Int16|Int32|Int64|Int128|Int|Integer|UInt8|UInt16|UInt32|UInt64|UInt128|UInt|Byte|Float16|Float32|Float64|Float128|Float|Decimal|Dec|Boolean|Char|String|Date|Time|DateTime|Instant|ZonedDateTime|TimeZone|Duration|Period|Regex|Array|List|Set|Map|Range|Function|Fn|Tuple|Weak|Pointer|NativeSlice|NativeSliceMut|Task|TaskSettlement|Channel|Thread|Mutex|RwLock|Semaphore|Barrier|Once|Atomic|Null|Void|Never|Object|Result|Option|Throwable)\\b"
        },
        {
          "name": "entity.name.type.zirk",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.zirk",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.cast.zirk",
          "match": "\\bis\\b"
        },
        {
          "name": "keyword.operator.zirk",
          "match": "\\+\\+|--|\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|=>|->|\\?\\?|\\?\\.|\\*\\*|\\+|-|\\*|/|%|<|>|=|!|\\?|:|&|\\||\\^|~"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.variable.zirk",
          "match": "\\b(stdin|stdout|stderr)\\b"
        },
        {
          "name": "support.function.zirk",
          "match": "\\b(print|println|to_string|assert|equal|expect|fatalError)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.zirk",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
