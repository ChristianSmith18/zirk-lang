{
  "name": "zirk-lang",
  "displayName": "Zirk Language Support",
  "description": "Syntax highlighting and language support for the Zirk programming language",
  "version": "0.1.6",
  "publisher": "cristian",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:zirk"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zirk",
        "aliases": [
          "Zirk",
          "zirk"
        ],
        "extensions": [
          ".zrk"
        ],
        "filenames": [
          "init.zrk"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/logo.svg",
          "dark": "./images/logo.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "zirk",
        "scopeName": "source.zirk",
        "path": "./syntaxes/zirk.tmLanguage.json"
      }
    ]
  }
}
