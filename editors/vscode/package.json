{
  "name": "zirk-lang",
  "displayName": "Zirk Language Support",
  "description": "Syntax, compiler diagnostics, semantic navigation, authoring support, versioned quick fixes, build/run commands, and language support for Zirk",
  "version": "0.6.0",
  "publisher": "ChristianSmith",
  "author": "Christian Smith",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:zirk",
    "onDebugResolve:zirk",
    "onDebugInitialConfigurations:zirk"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "zirk",
    "zirk-lang"
  ],
  "contributes": {
    "configurationDefaults": {
      "[zirk]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.semanticTokenColorCustomizations": {
          "enabled": true,
          "rules": {
            "namespace": "#F4A261",
            "type": "#32D4C6",
            "class": "#34D399",
            "interface": "#34D399",
            "struct": "#34D399",
            "enum": "#34D399",
            "enumMember": "#FF6B81",
            "typeParameter": "#A78BFA",
            "parameter": {
              "foreground": "#B8B8C3",
              "fontStyle": "italic"
            },
            "local": "#F7F7FA",
            "variable": "#F7F7FA",
            "property": "#F7C65C",
            "function": "#39C6FF",
            "method": "#38BDF8",
            "*.declaration": { "fontStyle": "bold" },
            "*.reference": { "fontStyle": "italic" },
            "*.import": { "fontStyle": "italic" }
          }
        }
      }
    },
    "configuration": {
      "title": "Zirk",
      "properties": {
        "zirk.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the zirk or zirk-check executable. If empty, the extension searches target/debug/zirk-check, target/release/zirk-check, target/debug/zirk, target/release/zirk, and PATH."
        },
        "zirk.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run the Zirk checker on the current file after saving."
        },
        "zirk.checkOnType": {
          "type": "boolean",
          "default": true,
          "description": "Run the Zirk checker as you type (debounced)."
        },
        "zirk.checkDelay": {
          "type": "number",
          "default": 500,
          "description": "Debounce delay in milliseconds for live checking while typing."
        },
        "zirk.brandColors": {
          "type": "boolean",
          "default": true,
          "description": "Apply the Zirk brand syntax palette (zirk-lang-site colors) to .zrk files, replacing the current theme's colors for Zirk scopes only."
        },
        "zirk.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to the zirk-lsp language server executable. If empty, the extension searches its bin directory, target/debug, target/release, and PATH. When the server runs it provides live diagnostics, hover, document/workspace symbols, formatting, definition/type definition, references, safe rename, completion and resolution, signature help, inlay hints, quick fixes, highlights, and semantic tokens; without it semantic editor features are unavailable and the CLI bridge remains the fallback."
        },
        "zirk.dapPath": {
          "type": "string",
          "default": "",
          "description": "Path to the zirk-dap interpreter debug adapter. If empty, the extension searches its bin directory, target/debug, target/release, and PATH."
        },
        "zirk.nativeDebuggerPath": {
          "type": "string",
          "default": "",
          "description": "Path to lldb-dap for native Zirk debugging. If empty, the extension uses xcrun on macOS and then searches PATH for lldb-dap or lldb-vscode."
        }
      }
    },
    "commands": [
      {
        "command": "zirk.check",
        "title": "Check File",
        "category": "Zirk"
      },
      {
        "command": "zirk.build",
        "title": "Build File",
        "category": "Zirk"
      },
      {
        "command": "zirk.run",
        "title": "Run File",
        "category": "Zirk",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "zirk.run",
          "when": "resourceLangId == zirk",
          "group": "navigation"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "zirk",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "The Zirk task to run",
            "enum": [
              "build",
              "run"
            ]
          },
          "file": {
            "type": "string",
            "description": "The .zrk file to compile or run"
          }
        }
      }
    ],
    "debuggers": [
      {
        "type": "zirk",
        "label": "Zirk",
        "languages": ["zirk"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to a .zrk file or a Zirk project directory"
              },
              "target": {
                "type": "string",
                "enum": ["interpreter", "native"],
                "default": "interpreter",
                "description": "Use the Zirk interpreter or compile with DWARF and debug through LLDB"
              },
              "cwd": {
                "type": "string",
                "description": "Workspace root allowed to contain the program"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "Pause before the first instruction in main"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "zirk",
            "request": "launch",
            "name": "Debug Zirk program",
            "program": "${file}",
            "target": "interpreter",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false
          },
          {
            "type": "zirk",
            "request": "launch",
            "name": "Debug Zirk program (native)",
            "program": "${file}",
            "target": "native",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "zirk",
        "aliases": [
          "Zirk",
          "zirk"
        ],
        "extensions": [
          ".zrk"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/logo.svg",
          "dark": "./images/logo.svg"
        }
      },
      {
        "id": "zirk-init",
        "aliases": [
          "Zirk Init",
          "zirk-init"
        ],
        "extensions": [
          ".zkinit"
        ],
        "filenames": [
          ".zkinit"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/zirk-init-gear.svg",
          "dark": "./images/zirk-init-gear.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "zirk",
        "scopeName": "source.zirk",
        "path": "./syntaxes/zirk.tmLanguage.json"
      },
      {
        "language": "zirk-init",
        "scopeName": "source.zirk",
        "path": "./syntaxes/zirk.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "zirk",
        "scopes": {
          "namespace": ["support.module.standard.zirk"],
          "type": ["storage.type.zirk"],
          "class": ["entity.name.class.zirk"],
          "interface": ["entity.name.type.zirk"],
          "struct": ["entity.name.type.zirk"],
          "enum": ["entity.name.type.zirk"],
          "enumMember": ["constant.language.zirk"],
          "typeParameter": ["entity.name.type.zirk"],
          "parameter": ["variable.parameter.zirk"],
          "local": ["variable.other.readwrite.zirk"],
          "variable": ["variable.other.readwrite.zirk"],
          "property": ["variable.other.property.zirk"],
          "function": ["entity.name.function.zirk"],
          "method": ["entity.name.function.call.zirk"]
        }
      }
    ],
    "snippets": [
      {
        "language": "zirk",
        "path": "./snippets/zirk.json"
      },
      {
        "language": "zirk-init",
        "path": "./snippets/zirk.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
