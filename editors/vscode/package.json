{
  "name": "zirk-lang",
  "displayName": "Zirk Language Support",
  "description": "Syntax highlighting, diagnostics, build/run commands, and language support for the Zirk programming language",
  "version": "0.6.0",
  "publisher": "ChristianSmith",
  "author": "Christian Smith",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "zirk",
    "zirk-lang"
  ],
  "contributes": {
    "configuration": {
      "title": "Zirk",
      "properties": {
        "zirk.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the zirk or zirk-check executable. If empty, the extension searches target/debug/zirk-check, target/release/zirk-check, target/debug/zirk, target/release/zirk, and PATH."
        },
        "zirk.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run the Zirk checker on the current file after saving."
        },
        "zirk.checkOnType": {
          "type": "boolean",
          "default": true,
          "description": "Run the Zirk checker as you type (debounced)."
        },
        "zirk.checkDelay": {
          "type": "number",
          "default": 500,
          "description": "Debounce delay in milliseconds for live checking while typing."
        },
        "zirk.brandColors": {
          "type": "boolean",
          "default": true,
          "description": "Apply the Zirk brand syntax palette (zirk-lang-site colors) to .zrk files, replacing the current theme's colors for Zirk scopes only."
        },
        "zirk.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to the zirk-lsp language server executable. If empty, the extension searches target/debug/zirk-lsp, target/release/zirk-lsp, and PATH. When the server runs it provides live diagnostics, hover, document symbols, and formatting; without it the CLI bridge remains the fallback."
        }
      }
    },
    "commands": [
      {
        "command": "zirk.check",
        "title": "Check File",
        "category": "Zirk"
      },
      {
        "command": "zirk.build",
        "title": "Build File",
        "category": "Zirk"
      },
      {
        "command": "zirk.run",
        "title": "Run File",
        "category": "Zirk",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "zirk.run",
          "when": "resourceLangId == zirk",
          "group": "navigation"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "zirk",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "The Zirk task to run",
            "enum": [
              "build",
              "run"
            ]
          },
          "file": {
            "type": "string",
            "description": "The .zrk file to compile or run"
          }
        }
      }
    ],
    "languages": [
      {
        "id": "zirk",
        "aliases": [
          "Zirk",
          "zirk"
        ],
        "extensions": [
          ".zrk"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/logo.svg",
          "dark": "./images/logo.svg"
        }
      },
      {
        "id": "zirk-init",
        "aliases": [
          "Zirk Init",
          "zirk-init"
        ],
        "extensions": [
          ".zkinit"
        ],
        "filenames": [
          ".zkinit"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/zirk-init-gear.svg",
          "dark": "./images/zirk-init-gear.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "zirk",
        "scopeName": "source.zirk",
        "path": "./syntaxes/zirk.tmLanguage.json"
      },
      {
        "language": "zirk-init",
        "scopeName": "source.zirk",
        "path": "./syntaxes/zirk.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zirk",
        "path": "./snippets/zirk.json"
      },
      {
        "language": "zirk-init",
        "path": "./snippets/zirk.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
