share class DirectoryWalkIterator implements Iterator<DirectoryEntry> {
    private inmut walker: DirectoryWalker;
    private mut finished: Boolean;

    private construct(walker: DirectoryWalker) {
        this.walker = walker;
        this.finished = false;
    }

    next(): Iteration<DirectoryEntry> {
        if this.finished { return Iteration.Done; }
        inmut entry = this.walker.next_entry();
        match entry {
            DirectoryEntry.End => {
                this.finished = true;
                return Iteration.Done;
            }
            DirectoryEntry.Error(_) => {
                this.finished = true;
                return Iteration.Item(entry);
            }
            _ => { return Iteration.Item(entry); }
        };
        return Iteration.Done;
    }
}

share class FileLock implements Resource<FileResourceError> {
    private inmut handle: UInt64;
    private mut closed: Boolean;

    private construct(handle: UInt64) {
        this.handle = handle;
        this.closed = false;
    }

    close(): Result<Void, FileResourceError> {
        if this.closed { return Ok(FileLock.unit()); }
        return match File.unlock_native(this.handle) {
            Ok(_) => {
                this.closed = true;
                FileLock.close_ok();
            }
            Error(error) => Error(FileResourceError(error));
        };
    }

    is_closed(): Boolean { return this.closed; }

    private static close_ok(): Result<Void, FileResourceError> {
        return Ok(FileLock.unit());
    }
    private static unit(): Void { return; }
}

share class Link {
    static is_link(path: Path): Result<Boolean, FileError> {
        return Link.is_link_native(path.as_string());
    }

    static read_target(path: Path): Result<Path, FileError> {
        return match Link.read_target_native(path.as_string()) {
            Ok(target) => Link.target_ok(Path(target));
            Error(error) => Error(error);
        };
    }

    static create(target: Path, destination: Path, kind: LinkKind): Result<Void, FileError> {
        return Link.create_link_native(target.as_string(), destination.as_string(), kind);
    }

    private static target_ok(value: Path): Result<Path, FileError> { return Ok(value); }

    private static is_link_native(path: String): Result<Boolean, FileError> {
        return Error(FileError.Io);
    }
    private static read_target_native(path: String): Result<String, FileError> {
        return Error(FileError.Io);
    }
    private static create_link_native(target: String, destination: String, kind: LinkKind): Result<Void, FileError> {
        return Error(FileError.Io);
    }
}

share class Temporary {
    static file(parent: Path): Result<TemporaryPath, FileError> {
        return match Temporary.create_file_native(parent.as_string()) {
            Ok(handle) => Temporary.file_ok(TemporaryPath(handle));
            Error(error) => Error(error);
        };
    }

    static directory(parent: Path): Result<TemporaryPath, FileError> {
        return match Temporary.create_directory_native(parent.as_string()) {
            Ok(handle) => Temporary.file_ok(TemporaryPath(handle));
            Error(error) => Error(error);
        };
    }

