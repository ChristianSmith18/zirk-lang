import { Path, PathError } from std.path::path;

share enum FileError {
    InvalidPath,
    InvalidOptions,
    NotFound,
    PermissionDenied,
    AlreadyExists,
    WrongType,
    Closed,
    Decoding,
    Limit,
    EndOfStream,
    Unsupported,
    Io,
    WouldBlock,
    CrossDevice,
    NotEmpty,
    Cancelled,
}

share enum Encoding { Utf8, Latin1, Utf16Le, Utf16Be }

share enum FileLine { Line(text: String), End, Error(error: FileError) }
share enum FileChunk { Data(bytes: Array<Byte>), Error(error: FileError) }
share enum DirectoryEntryKind { File, Directory, Symlink, Other }
share enum DirectoryEntry {
    Item(path: String, kind: DirectoryEntryKind),
    End,
    Error(error: FileError),
}
share enum LinkKind { File, Directory }
share enum FileWatchEvent {
    Created(path: String),
    Modified(path: String),
    Removed(path: String),
    Renamed(path: String),
    Overflow,
    Closed,
    Error(error: FileError),
}

share class FileResourceError implements Error {
    private inmut reason: FileError;

    construct(reason: FileError) { this.reason = reason; }

    message(): String { return this.reason.to_string(); }
    code(): String { return "FILE_RESOURCE"; }
    cause(): Error? { return null; }
}

share class OpenOptions {
    private inmut read: Boolean;
    private inmut write: Boolean;
    private inmut append_enabled: Boolean;
    private inmut create: Boolean;
    private inmut create_new_enabled: Boolean;
    private inmut truncate: Boolean;

    private construct(
        read: Boolean,
        write: Boolean,
        append_enabled: Boolean,
        create: Boolean,
        create_new_enabled: Boolean,
        truncate: Boolean,
    ) {
        this.read = read;
        this.write = write;
        this.append_enabled = append_enabled;
        this.create = create;
        this.create_new_enabled = create_new_enabled;
        this.truncate = truncate;
    }

    static none(): OpenOptions { return OpenOptions(false, false, false, false, false, false); }
    static read_only(): OpenOptions { return OpenOptions(true, false, false, false, false, false); }
    static write_only(): OpenOptions { return OpenOptions(false, true, false, false, false, false); }
    static read_and_write(): OpenOptions { return OpenOptions(true, true, false, false, false, false); }
    static appending(): OpenOptions { return OpenOptions(false, true, true, true, false, false); }
    static creating_new(): OpenOptions { return OpenOptions(false, true, false, false, true, false); }

    with_read(value: Boolean): OpenOptions {
        return OpenOptions(value, this.write, this.append_enabled, this.create, this.create_new_enabled, this.truncate);
    }

    with_write(value: Boolean): OpenOptions {
        return OpenOptions(this.read, value, this.append_enabled, this.create, this.create_new_enabled, this.truncate);
    }

    with_append(value: Boolean): OpenOptions {
        return OpenOptions(this.read, true, value, this.create, this.create_new_enabled, this.truncate);
    }

    with_create(value: Boolean): OpenOptions {
        return OpenOptions(this.read, this.write, this.append_enabled, value, this.create_new_enabled, this.truncate);
    }

    with_create_new(value: Boolean): OpenOptions {
        return OpenOptions(this.read, this.write, this.append_enabled, this.create, value, this.truncate);
    }

    with_truncate(value: Boolean): OpenOptions {
        return OpenOptions(this.read, this.write, this.append_enabled, this.create, this.create_new_enabled, value);
    }

    flags(): UInt32 {
        mut value: UInt32 = 0;
        if this.read { value += 1; }
        if this.write { value += 2; }
        if this.append_enabled { value += 4; }
        if this.create { value += 8; }
        if this.create_new_enabled { value += 16; }
        if this.truncate { value += 32; }
        return value;
    }
}

share class FileMetadata {
    private inmut values: Array<UInt64>;

    private construct(values: Array<UInt64>) { this.values = values; }

    size(): UInt64 { return this.values[0]; }
    is_file(): Boolean { return this.values[1] != 0; }
    is_directory(): Boolean { return this.values[2] != 0; }
    is_symlink(): Boolean { return this.values[5] != 0; }
    is_readonly(): Boolean { return this.values[6] != 0; }
    modified_unix_ms(): UInt64? {
        if this.values[4] == 0 { return null; }
        return this.values[3];
    }
    accessed_unix_ms(): UInt64? {
        if this.values[8] == 0 { return null; }
        return this.values[7];
    }
    created_unix_ms(): UInt64? {
        if this.values[10] == 0 { return null; }
        return this.values[9];
    }
}

share class File implements Resource<FileResourceError> {
    private inmut handle: UInt64;

    private construct(handle: UInt64) { this.handle = handle; }

    static read_bytes(path: Path, limit: UInt64): Result<Array<Byte>, FileError> {
        return File.read_bytes_native(path.as_string(), limit);
    }

    static read_text(
        path: Path,
        limit: UInt64,
        encoding: Encoding = Encoding.Utf8,
    ): Result<String, FileError> {
        return File.read_text_native(path.as_string(), limit, encoding);
    }

    static read_bytes_async(path: Path, limit: UInt64): Result<Array<Byte>, FileError> {
        return File.read_bytes_async_native(path.as_string(), limit);
    }

    static read_text_async(
        path: Path,
        limit: UInt64,
        encoding: Encoding = Encoding.Utf8,
    ): Result<String, FileError> {
        return File.read_text_async_native(path.as_string(), limit, encoding);
    }

    static write_bytes(path: Path, bytes: Array<Byte>): Result<Void, FileError> {
        return File.write_bytes_native(path.as_string(), bytes);
    }

    static write_text(
        path: Path,
        text: String,
        encoding: Encoding = Encoding.Utf8,
    ): Result<Void, FileError> {
        return File.write_text_native(path.as_string(), text, encoding);
    }

    static write_bytes_async(path: Path, bytes: Array<Byte>): Result<Void, FileError> {
        return File.write_bytes_async_native(path.as_string(), bytes);
    }

    static write_text_async(
        path: Path,
        text: String,
        encoding: Encoding = Encoding.Utf8,
    ): Result<Void, FileError> {
        return File.write_text_async_native(path.as_string(), text, encoding);
    }

    static open(path: Path, options: OpenOptions): Result<File, FileError> {
        return match File.open_native(path.as_string(), options.flags()) {
            Ok(handle) => File.open_ok(File(handle));
            Error(error) => Error(error);
        };
    }

    static open_async(path: Path, options: OpenOptions): Result<File, FileError> {
        return match File.open_async_native(path.as_string(), options.flags()) {
            Ok(handle) => File.open_ok(File(handle));
            Error(error) => Error(error);
        };
    }

    read(max_bytes: UInt64): Result<Array<Byte>, FileError> {
        return File.read_bytes_handle_native(this.handle, max_bytes);
    }

    read_async(max_bytes: UInt64): Result<Array<Byte>, FileError> {
        return File.read_bytes_handle_async_native(this.handle, max_bytes);
    }

    write_async(bytes: Array<Byte>): Result<UInt64, FileError> {
        return File.write_handle_async_native(this.handle, bytes);
    }

    read_exact(count: UInt64): Result<Array<Byte>, FileError> {
        return File.read_exact_native(this.handle, count);
    }

    read_exact_async(count: UInt64): Result<Array<Byte>, FileError> {
        return File.read_exact_async_native(this.handle, count);
    }

    read_line(): Result<FileLine, FileError> {
        return File.read_line_native(this.handle);
    }

    lines(): FileLines { return FileLines(this); }

    chunks(size: UInt64): Result<FileChunks, FileError> {
        if size == 0 || size > 4194304 { return Error(FileError.Limit); }
        return Ok(FileChunks(this, size));
    }

    append(bytes: Array<Byte>): Result<Void, FileError> {
        return File.append_handle_native(this.handle, bytes);
    }

    append_async(bytes: Array<Byte>): Result<Void, FileError> {
        return File.append_handle_async_native(this.handle, bytes);
    }

    metadata(): Result<FileMetadata, FileError> {
        return match File.metadata_native(this.handle) {
            Ok(values) => File.metadata_ok(values);
            Error(error) => Error(error);
        };
    }

    close(): Result<Void, FileResourceError> {
        return match File.close_native(this.handle) {
            Ok(_) => File.close_ok();
            Error(error) => File.close_error(error);
        };
    }

    is_closed(): Boolean { return File.is_closed_native(this.handle); }

    static exists(path: Path): Result<Boolean, FileError> {
        return File.exists_native(path.as_string());
    }

    static metadata_for(path: Path): Result<FileMetadata, FileError> {
        return match File.metadata_for_native(path.as_string()) {
            Ok(values) => File.metadata_ok(values);
            Error(error) => Error(error);
        };
    }

    static set_readonly(path: Path, readonly: Boolean): Result<Void, FileError> {
        return File.set_readonly_native(path.as_string(), readonly);
    }

    lock_shared(): Result<FileLock, FileError> {
        return match File.lock_native(this.handle, false, false) {
            Ok(handle) => File.lock_ok(handle);
            Error(error) => Error(error);
        };
    }

    lock_exclusive(): Result<FileLock, FileError> {
        return match File.lock_native(this.handle, true, false) {
            Ok(handle) => File.lock_ok(handle);
            Error(error) => Error(error);
        };
    }

    try_lock_shared(): Result<FileLock, FileError> {
        return match File.lock_native(this.handle, false, true) {
            Ok(handle) => File.lock_ok(handle);
            Error(error) => Error(error);
        };
    }

    try_lock_exclusive(): Result<FileLock, FileError> {
        return match File.lock_native(this.handle, true, true) {
            Ok(handle) => File.lock_ok(handle);
            Error(error) => Error(error);
        };
    }

    lock_shared_async(): Result<FileLock, FileError> {
        return match File.lock_async_native(this.handle, false) {
            Ok(handle) => File.lock_ok(handle);
            Error(error) => Error(error);
        };
    }

    lock_exclusive_async(): Result<FileLock, FileError> {
        return match File.lock_async_native(this.handle, true) {
            Ok(handle) => File.lock_ok(handle);
            Error(error) => Error(error);
        };
    }

    static append_bytes(path: Path, bytes: Array<Byte>): Result<Void, FileError> {
        return File.append_bytes_native(path.as_string(), bytes);
    }

    static append_text(path: Path, text: String, encoding: Encoding = Encoding.Utf8): Result<Void, FileError> {
        return File.append_text_native(path.as_string(), text, encoding);
    }

    static append_bytes_async(path: Path, bytes: Array<Byte>): Result<Void, FileError> {
        return File.append_bytes_async_native(path.as_string(), bytes);
    }

    static append_text_async(
        path: Path,
        text: String,
        encoding: Encoding = Encoding.Utf8,
    ): Result<Void, FileError> {
        return File.append_text_async_native(path.as_string(), text, encoding);
    }

    static write_bytes_atomic(path: Path, bytes: Array<Byte>): Result<Void, FileError> {
        return File.write_bytes_atomic_native(path.as_string(), bytes);
    }

    static write_text_atomic(path: Path, text: String): Result<Void, FileError> {
        return File.write_text_atomic_native(path.as_string(), text);
    }

    private static open_ok(value: File): Result<File, FileError> { return Ok(value); }
    private static metadata_ok(values: Array<UInt64>): Result<FileMetadata, FileError> {
        return Ok(FileMetadata(values));
    }
    private static lock_ok(handle: UInt64): Result<FileLock, FileError> {
        return Ok(FileLock(handle));
    }
    private static close_ok(): Result<Void, FileResourceError> { return Ok(File.unit()); }
    private static unit(): Void { return; }
    private static close_error(error: FileError): Result<Void, FileResourceError> {
        return Error(FileResourceError(error));
    }

    private static read_bytes_native(path: String, limit: UInt64): Result<Array<Byte>, FileError> {
        return Error(FileError.Io);
    }
    private static read_text_native(path: String, limit: UInt64, encoding: Encoding): Result<String, FileError> {
        return Error(FileError.Io);
    }
    private static read_bytes_async_native(path: String, limit: UInt64): Result<Array<Byte>, FileError> {
        return Error(FileError.Io);
    }
    private static read_text_async_native(path: String, limit: UInt64, encoding: Encoding): Result<String, FileError> {
        return Error(FileError.Io);
    }
    private static write_bytes_native(path: String, bytes: Array<Byte>): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static write_text_native(path: String, text: String, encoding: Encoding): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static write_bytes_async_native(path: String, bytes: Array<Byte>): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static write_text_async_native(path: String, text: String, encoding: Encoding): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static open_native(path: String, flags: UInt32): Result<UInt64, FileError> {
        return Error(FileError.Io);
    }
    private static open_async_native(path: String, flags: UInt32): Result<UInt64, FileError> {
        return Error(FileError.Io);
    }
    private static close_native(handle: UInt64): Result<Void, FileError> { return Error(FileError.Closed); }
    private static is_closed_native(handle: UInt64): Boolean { return true; }
    private static read_bytes_handle_native(handle: UInt64, max_bytes: UInt64): Result<Array<Byte>, FileError> {
        return Error(FileError.Io);
    }
    private static read_bytes_handle_async_native(handle: UInt64, max_bytes: UInt64): Result<Array<Byte>, FileError> {
        return Error(FileError.Io);
    }
    private static write_handle_async_native(handle: UInt64, bytes: Array<Byte>): Result<UInt64, FileError> {
        return Error(FileError.Io);
    }
    private static read_exact_native(handle: UInt64, count: UInt64): Result<Array<Byte>, FileError> {
        return Error(FileError.EndOfStream);
    }
    private static read_exact_async_native(handle: UInt64, count: UInt64): Result<Array<Byte>, FileError> {
        return Error(FileError.EndOfStream);
    }
    private static read_line_native(handle: UInt64): Result<FileLine, FileError> {
        return Error(FileError.Io);
    }
    private static append_bytes_native(path: String, bytes: Array<Byte>): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static append_handle_native(handle: UInt64, bytes: Array<Byte>): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static append_text_native(path: String, text: String, encoding: Encoding): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static append_bytes_async_native(path: String, bytes: Array<Byte>): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static append_text_async_native(path: String, text: String, encoding: Encoding): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static append_handle_async_native(handle: UInt64, bytes: Array<Byte>): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static metadata_native(handle: UInt64): Result<Array<UInt64>, FileError> {
        return Error(FileError.Io);
    }
    private static metadata_for_native(path: String): Result<Array<UInt64>, FileError> {
        return Error(FileError.Io);
    }
    private static set_readonly_native(path: String, readonly: Boolean): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static lock_native(handle: UInt64, exclusive: Boolean, nonblocking: Boolean): Result<UInt64, FileError> {
        return Error(FileError.Io);
    }
    static unlock_native(handle: UInt64): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static lock_async_native(handle: UInt64, exclusive: Boolean): Result<UInt64, FileError> {
        return Error(FileError.Io);
    }
    private static exists_native(path: String): Result<Boolean, FileError> { return Ok(false); }
    private static write_bytes_atomic_native(path: String, bytes: Array<Byte>): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static write_text_atomic_native(path: String, text: String): Result<Void, FileError> {
        return Error(FileError.Io);
    }
}

share class FileLines implements Iterable<FileLine> {
    private inmut file: File;

    private construct(file: File) { this.file = file; }

    iterator(): Iterator<FileLine> {
        return FileLineIterator(this.file);
    }
}

share class FileLineIterator implements Iterator<FileLine> {
    private inmut file: File;
    private mut finished: Boolean;

    private construct(file: File) {
        this.file = file;
        this.finished = false;
    }

    next(): Iteration<FileLine> {
        if this.finished { return Iteration.Done; }
        if this.file.is_closed() {
            this.finished = true;
            return Iteration.Item(FileLine.Error(FileError.Closed));
        }
        match this.file.read_line() {
            Error(error) => {
                this.finished = true;
                return Iteration.Item(FileLine.Error(error));
            }
            Ok(line) => {
                match line {
                    FileLine.End => {
                        this.finished = true;
                        return Iteration.Done;
                    }
                    FileLine.Line(text) => {
                        return Iteration.Item(FileLine.Line(text));
                    }
                    FileLine.Error(error) => {
                        this.finished = true;
                        return Iteration.Item(FileLine.Error(error));
                    }
                }
            }
        };
        return Iteration.Done;
    }
}

share class FileChunks implements Iterable<FileChunk> {
    private inmut file: File;
    private inmut size: UInt64;

    private construct(file: File, size: UInt64) {
        this.file = file;
        this.size = size;
    }

    iterator(): Iterator<FileChunk> {
        return FileChunkIterator(this.file, this.size);
    }
}

share class FileChunkIterator implements Iterator<FileChunk> {
    private inmut file: File;
    private inmut size: UInt64;
    private mut finished: Boolean;

    private construct(file: File, size: UInt64) {
        this.file = file;
        this.size = size;
        this.finished = false;
    }

    next(): Iteration<FileChunk> {
        if this.finished { return Iteration.Done; }
        if this.file.is_closed() {
            this.finished = true;
            return Iteration.Item(FileChunk.Error(FileError.Closed));
        }
        match this.file.read(this.size) {
            Error(error) => {
                this.finished = true;
                return Iteration.Item(FileChunk.Error(error));
            }
            Ok(bytes) => {
                if bytes.length == 0 {
                    this.finished = true;
                    return Iteration.Done;
                } else {
                    return Iteration.Item(FileChunk.Data(bytes));
                }
            }
        };
        return Iteration.Done;
    }
}

share class Directory {
    static create(path: Path): Result<Void, FileError> {
        return Directory.create_native(path.as_string());
    }

    static create_all(path: Path): Result<Void, FileError> {
        return Directory.create_all_native(path.as_string());
    }

    static entries(path: Path): Result<DirectoryEntries, FileError> {
        return match Directory.entries_open_native(path.as_string()) {
            Ok(handle) => Directory.entries_ok(DirectoryEntries(handle));
            Error(error) => Error(error);
        };
    }

    static entries_async(path: Path): Result<DirectoryEntries, FileError> {
        return match Directory.entries_open_async_native(path.as_string()) {
            Ok(handle) => Directory.entries_ok(DirectoryEntries(handle));
            Error(error) => Error(error);
        };
    }

    static walk(
        path: Path,
        max_depth: UInt32,
        max_entries: UInt64,
    ): Result<DirectoryWalker, FileError> {
        return match Directory.walk_open_native(path.as_string(), max_depth, max_entries) {
            Ok(handle) => Directory.walk_ok(DirectoryWalker(handle));
            Error(error) => Error(error);
        };
    }

    static walk_async(
        path: Path,
        max_depth: UInt32,
        max_entries: UInt64,
    ): Result<DirectoryWalker, FileError> {
        return match Directory.walk_open_async_native(path.as_string(), max_depth, max_entries) {
            Ok(handle) => Directory.walk_ok(DirectoryWalker(handle));
            Error(error) => Error(error);
        };
    }

    static is_empty(path: Path): Result<Boolean, FileError> {
        return Directory.is_empty_native(path.as_string());
    }

    static size(
        path: Path,
        max_depth: UInt32,
        max_entries: UInt64,
        max_bytes: UInt64,
    ): Result<UInt64, FileError> {
        return Directory.size_native(path.as_string(), max_depth, max_entries, max_bytes);
    }

    static copy(
        source: Path,
        destination: Path,
        replace: Boolean,
        max_depth: UInt32,
        max_entries: UInt64,
    ): Result<Void, FileError> {
        return Directory.copy_native(
            source.as_string(), destination.as_string(), replace, max_depth, max_entries,
        );
    }

    static move(source: Path, destination: Path, replace: Boolean): Result<Void, FileError> {
        return Directory.move_native(source.as_string(), destination.as_string(), replace);
    }

    static remove(path: Path): Result<Void, FileError> {
        return Directory.remove_native(path.as_string());
    }

    static remove_all(
        path: Path,
        max_depth: UInt32,
        max_entries: UInt64,
    ): Result<Void, FileError> {
        return Directory.remove_all_native(path.as_string(), max_depth, max_entries);
    }

    static watch(
        path: Path,
        recursive: Boolean = false,
        queue_capacity: UInt32 = 256 as UInt32,
    ): Result<FileWatcher, FileError> {
        return match Directory.watch_native(path.as_string(), recursive, queue_capacity) {
            Ok(handle) => Directory.watcher_ok(FileWatcher(handle));
            Error(error) => Error(error);
        };
    }

    private static entries_ok(value: DirectoryEntries): Result<DirectoryEntries, FileError> {
        return Ok(value);
    }
    private static walk_ok(value: DirectoryWalker): Result<DirectoryWalker, FileError> {
        return Ok(value);
    }
    private static watcher_ok(value: FileWatcher): Result<FileWatcher, FileError> {
        return Ok(value);
    }

    private static create_native(path: String): Result<Void, FileError> { return Error(FileError.Io); }
    private static create_all_native(path: String): Result<Void, FileError> { return Error(FileError.Io); }
    private static entries_open_native(path: String): Result<UInt64, FileError> {
        return Error(FileError.Io);
    }
    private static entries_open_async_native(path: String): Result<UInt64, FileError> {
        return Error(FileError.Io);
    }
    static entries_next_native(handle: UInt64): Result<String, FileError> {
        return Error(FileError.Io);
    }
    static entries_next_async_native(handle: UInt64): Result<String, FileError> {
        return Error(FileError.Io);
    }
    static entries_close_native(handle: UInt64): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static walk_open_native(
        path: String,
        max_depth: UInt32,
        max_entries: UInt64,
    ): Result<UInt64, FileError> {
        return Error(FileError.Io);
    }
    private static walk_open_async_native(
        path: String,
        max_depth: UInt32,
        max_entries: UInt64,
    ): Result<UInt64, FileError> {
        return Error(FileError.Io);
    }
    static walk_next_native(handle: UInt64): Result<String, FileError> {
        return Error(FileError.Io);
    }
    static walk_next_async_native(handle: UInt64): Result<String, FileError> {
        return Error(FileError.Io);
    }
    static walk_close_native(handle: UInt64): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static is_empty_native(path: String): Result<Boolean, FileError> {
        return Error(FileError.Io);
    }
    private static size_native(
        path: String,
        max_depth: UInt32,
        max_entries: UInt64,
        max_bytes: UInt64,
    ): Result<UInt64, FileError> {
        return Error(FileError.Io);
    }
    private static copy_native(
        source: String,
        destination: String,
        replace: Boolean,
        max_depth: UInt32,
        max_entries: UInt64,
    ): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static move_native(source: String, destination: String, replace: Boolean): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static remove_native(path: String): Result<Void, FileError> { return Error(FileError.Io); }
    private static remove_all_native(
        path: String,
        max_depth: UInt32,
        max_entries: UInt64,
    ): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static watch_native(
        path: String,
        recursive: Boolean,
        queue_capacity: UInt32,
    ): Result<UInt64, FileError> {
        return Error(FileError.Io);
    }
}

share class DirectoryEntries implements Iterable<DirectoryEntry>, Resource<FileResourceError> {
    private inmut handle: UInt64;
    private mut closed: Boolean;

    private construct(handle: UInt64) {
        this.handle = handle;
        this.closed = false;
    }

    iterator(): Iterator<DirectoryEntry> { return DirectoryEntryIterator(this); }

    next_entry(): DirectoryEntry {
        if this.closed { return DirectoryEntry.Error(FileError.Closed); }
        return match Directory.entries_next_native(this.handle) {
            Error(error) => DirectoryEntry.Error(error);
            Ok(encoded) => {
                if encoded.length == 0 {
                    this.closed = true;
                    DirectoryEntry.End
                } else {
                    DirectoryEntries.decode_entry(encoded)
                }
            }
        };
    }

    next_entry_async(): DirectoryEntry {
        if this.closed { return DirectoryEntry.Error(FileError.Closed); }
        return match Directory.entries_next_async_native(this.handle) {
            Error(error) => DirectoryEntry.Error(error);
            Ok(encoded) => {
                if encoded.length == 0 {
                    this.closed = true;
                    DirectoryEntry.End
                } else {
                    DirectoryEntries.decode_entry(encoded)
                }
            }
        };
    }

    close(): Result<Void, FileResourceError> {
        if this.closed { return Ok(DirectoryEntries.unit()); }
        this.closed = true;
        return match Directory.entries_close_native(this.handle) {
            Ok(_) => Ok(DirectoryEntries.unit());
            Error(error) => Error(FileResourceError(error));
        };
    }

    is_closed(): Boolean { return this.closed; }

    static decode_entry(encoded: String): DirectoryEntry {
        if encoded.length < 2 { return DirectoryEntry.Error(FileError.InvalidPath); }
        inmut marker = encoded.substring(0, 1);
        inmut path = encoded.substring(1, encoded.length);
        return match marker {
            "f" => DirectoryEntry.Item(path, DirectoryEntryKind.File);
            "d" => DirectoryEntry.Item(path, DirectoryEntryKind.Directory);
            "l" => DirectoryEntry.Item(path, DirectoryEntryKind.Symlink);
            _ => DirectoryEntry.Item(path, DirectoryEntryKind.Other);
        };
    }

    private static unit(): Void { return; }
}

share class DirectoryEntryIterator implements Iterator<DirectoryEntry> {
    private inmut entries: DirectoryEntries;
    private mut finished: Boolean;

    private construct(entries: DirectoryEntries) {
        this.entries = entries;
        this.finished = false;
    }

    next(): Iteration<DirectoryEntry> {
        if this.finished { return Iteration.Done; }
        inmut entry = this.entries.next_entry();
        match entry {
            DirectoryEntry.End => {
                this.finished = true;
                return Iteration.Done;
            }
            DirectoryEntry.Error(_) => {
                this.finished = true;
                return Iteration.Item(entry);
            }
            _ => { return Iteration.Item(entry); }
        };
        return Iteration.Done;
    }
}

