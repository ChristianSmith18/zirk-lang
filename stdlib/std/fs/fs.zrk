        return Ok(value);
    }
    private static create_file_native(parent: String): Result<UInt64, FileError> {
        return Error(FileError.Io);
    }
    private static create_directory_native(parent: String): Result<UInt64, FileError> {
        return Error(FileError.Io);
    }
    static path_native(handle: UInt64): Result<String, FileError> {
        return Error(FileError.Io);
    }
    static cleanup_native(handle: UInt64): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    static release_native(handle: UInt64): Result<Void, FileError> {
        return Error(FileError.Io);
    }
}

share class TemporaryPath implements Resource<FileResourceError> {
    private inmut handle: UInt64;
    private mut closed: Boolean;

    private construct(handle: UInt64) {
        this.handle = handle;
        this.closed = false;
    }

    path(): Result<Path, FileError> {
        return match Temporary.path_native(this.handle) {
            Ok(path) => TemporaryPath.path_ok(Path(path));
            Error(error) => Error(error);
        };
    }

    release(): Result<Void, FileResourceError> {
        if this.closed { return Ok(TemporaryPath.unit()); }
        return match Temporary.release_native(this.handle) {
            Ok(_) => {
                this.closed = true;
                TemporaryPath.closed_ok();
            }
            Error(error) => Error(FileResourceError(error));
        };
    }

    close(): Result<Void, FileResourceError> {
        if this.closed { return Ok(TemporaryPath.unit()); }
        return match Temporary.cleanup_native(this.handle) {
            Ok(_) => {
                this.closed = true;
                TemporaryPath.closed_ok();
            }
            Error(error) => Error(FileResourceError(error));
        };
    }

    is_closed(): Boolean { return this.closed; }

    private static closed_ok(): Result<Void, FileResourceError> {
        return Ok(TemporaryPath.unit());
    }
    private static path_ok(value: Path): Result<Path, FileError> { return Ok(value); }
    private static unit(): Void { return; }
}

share class FileWatcher implements Resource<FileResourceError> {
    private inmut handle: UInt64;
    private mut closed: Boolean;

    private construct(handle: UInt64) {
        this.handle = handle;
        this.closed = false;
    }

    next(): Result<FileWatchEvent, FileError> {
        if this.closed { return Error(FileError.Closed); }
        return match FileWatcher.next_native(this.handle) {
            Ok(encoded) => FileWatcher.decode_event(encoded);
            Error(error) => Error(error);
        };
    }

    next_async(): Result<FileWatchEvent, FileError> {
        if this.closed { return Error(FileError.Closed); }
        return match FileWatcher.next_async_native(this.handle) {
            Ok(encoded) => FileWatcher.decode_event(encoded);
            Error(error) => Error(error);
        };
    }

    close(): Result<Void, FileResourceError> {
        if this.closed { return Ok(FileWatcher.unit()); }
        this.closed = true;
        return match FileWatcher.watcher_close_native(this.handle) {
            Ok(_) => Ok(FileWatcher.unit());
            Error(error) => Error(FileResourceError(error));
        };
    }

    is_closed(): Boolean { return this.closed; }

    private static decode_event(encoded: String): Result<FileWatchEvent, FileError> {
        if encoded.length == 0 { return Error(FileError.InvalidPath); }
        inmut marker = encoded.substring(0, 1);
        inmut path = encoded.substring(1, encoded.length);
        return match marker {
            "c" => Ok(FileWatchEvent.Created(path));
            "m" => Ok(FileWatchEvent.Modified(path));
            "d" => Ok(FileWatchEvent.Removed(path));
            "r" => Ok(FileWatchEvent.Renamed(path));
            "o" => Ok(FileWatchEvent.Overflow);
            "x" => Ok(FileWatchEvent.Closed);
            "A" => Ok(FileWatchEvent.Error(FileError.InvalidPath));
            "B" => Ok(FileWatchEvent.Error(FileError.InvalidOptions));
            "C" => Ok(FileWatchEvent.Error(FileError.NotFound));
            "D" => Ok(FileWatchEvent.Error(FileError.PermissionDenied));
            "E" => Ok(FileWatchEvent.Error(FileError.AlreadyExists));
            "F" => Ok(FileWatchEvent.Error(FileError.WrongType));
            "G" => Ok(FileWatchEvent.Error(FileError.Closed));
            "H" => Ok(FileWatchEvent.Error(FileError.Decoding));
            "I" => Ok(FileWatchEvent.Error(FileError.Limit));
            "J" => Ok(FileWatchEvent.Error(FileError.EndOfStream));
            "K" => Ok(FileWatchEvent.Error(FileError.Unsupported));
            "L" => Ok(FileWatchEvent.Error(FileError.Io));
            "M" => Ok(FileWatchEvent.Error(FileError.WouldBlock));
            "N" => Ok(FileWatchEvent.Error(FileError.CrossDevice));
            "O" => Ok(FileWatchEvent.Error(FileError.NotEmpty));
            "P" => Ok(FileWatchEvent.Error(FileError.Cancelled));
            _ => Error(FileError.InvalidPath);
        };
    }

    private static next_native(handle: UInt64): Result<String, FileError> {
        return Error(FileError.Io);
    }
    private static next_async_native(handle: UInt64): Result<String, FileError> {
        return Error(FileError.Io);
    }
    private static watcher_close_native(handle: UInt64): Result<Void, FileError> {
        return Error(FileError.Io);
    }
    private static unit(): Void { return; }
}
