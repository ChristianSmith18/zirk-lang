package std.net.tls;

share enum TLSError {
    InvalidAddress,
    PermissionDenied,
    AddressNotAllowed,
    DnsFailure,
    DnsResultLimit,
    UnsupportedTransport,
    CertificateStore,
    InvalidServerName,
    InvalidServerIdentity,
    TlsHandshake,
    BufferLimitExceeded,
    Io,
    Cancelled,
    CapacityExceeded,
    Timeout,
    Closed,
    WrongOwner,
    InvalidConfiguration,
}

share enum TLSReadResult<T> {
    Value(value: T),
    End,
    Error(error: TLSError),
}

share class TLSResourceError implements Error {
    private inmut reason: TLSError;

    construct(reason: TLSError) { this.reason = reason; }

    message(): String { return this.reason.to_string(); }
    code(): String { return "TLS_RESOURCE"; }
    cause(): Error? { return null; }
}

// TLS 1.3, system trust roots, SNI, and hostname/certificate validation are
// the defaults. TLS 1.2 is enabled only by explicitly passing allow_tls12.
share class TLSStream implements Resource<TLSResourceError> {
    private inmut handle: UInt64;

    private construct(handle: UInt64) { this.handle = handle; }

    static connect(endpoint: String): Result<TLSStream, TLSError> {
        return match TLSStream.connect_native(endpoint) {
            Ok(handle) => TLSStream.connect_ok(TLSStream(handle));
            Error(error) => TLSStream.connect_error(error);
        };
    }

    static connect_with_trust_roots(
        endpoint: String,
        roots_der: Array<Array<Byte>>,
        allow_tls12: Boolean,
    ): Result<TLSStream, TLSError> {
        return match TLSStream.connect_with_trust_roots_native(endpoint, roots_der, allow_tls12) {
            Ok(handle) => TLSStream.connect_ok(TLSStream(handle));
            Error(error) => TLSStream.connect_error(error);
        };
    }

    // Selects application protocols during the authenticated TLS handshake.
    // System trust roots and TLS 1.3 remain the defaults for this overload.
    static connect_with_alpn(
        endpoint: String,
        protocols: Array<String>,
    ): Result<TLSStream, TLSError> {
        mut roots: Array<Array<Byte>> = [];
        return match TLSStream.connect_with_options_native(endpoint, roots, false, protocols) {
            Ok(handle) => TLSStream.connect_ok(TLSStream(handle));
            Error(error) => TLSStream.connect_error(error);
        };
    }

    // Empty roots select the platform trust store. TLS 1.2 is opt-in.
    static connect_with_options(
        endpoint: String,
        roots_der: Array<Array<Byte>>,
        allow_tls12: Boolean,
        protocols: Array<String>,
    ): Result<TLSStream, TLSError> {
        return match TLSStream.connect_with_options_native(endpoint, roots_der, allow_tls12, protocols) {
            Ok(handle) => TLSStream.connect_ok(TLSStream(handle));
            Error(error) => TLSStream.connect_error(error);
        };
    }

    // Configures mutual TLS with caller-owned DER client credentials. Empty
    // roots select the platform trust store; TLS 1.2 remains opt-in.
    static connect_with_client_identity(
        endpoint: String,
        roots_der: Array<Array<Byte>>,
        client_certificate_chain_der: Array<Array<Byte>>,
        client_private_key_der: Array<Byte>,
        allow_tls12: Boolean,
        protocols: Array<String>,
    ): Result<TLSStream, TLSError> {
        return match TLSStream.connect_with_client_identity_native(
            endpoint,
            roots_der,
            client_certificate_chain_der,
            client_private_key_der,
            allow_tls12,
            protocols,
        ) {
            Ok(handle) => TLSStream.connect_ok(TLSStream(handle));
            Error(error) => TLSStream.connect_error(error);
        };
    }

    read(max_bytes: UInt64): TLSReadResult<Array<Byte>> {
        return TLSStream.read_native(this.handle, max_bytes);
    }

    write_all(bytes: Array<Byte>): Result<Void, TLSError> {
        return TLSStream.write_all_native(this.handle, bytes);
    }

    shutdown(): Result<Void, TLSError> {
        return TLSStream.shutdown_native(this.handle);
    }

    close(): Result<Void, TLSResourceError> {
        return match TLSStream.close_native(this.handle) {
            Ok(_) => TLSStream.close_ok();
            Error(error) => TLSStream.close_error(error);
        };
    }

    is_closed(): Boolean { return TLSStream.is_closed_native(this.handle); }

    peer_address(): Result<String, TLSError> {
        return TLSStream.peer_address_native(this.handle);
    }

    negotiated_alpn(): Result<String?, TLSError> {
        return TLSStream.negotiated_alpn_native(this.handle);
    }

    // Returns the SHA-256 fingerprint of the authenticated peer certificate,
    // or null when the TLS role has no peer certificate metadata.
    peer_certificate_sha256(): Result<String?, TLSError> {
        return TLSStream.peer_certificate_sha256_native(this.handle);
    }

    private static connect_native(endpoint: String): Result<UInt64, TLSError> {
        return Error(TLSError.PermissionDenied);
    }

    private static connect_with_trust_roots_native(
        endpoint: String,
        roots_der: Array<Array<Byte>>,
        allow_tls12: Boolean,
    ): Result<UInt64, TLSError> {
        return Error(TLSError.CertificateStore);
    }

    private static connect_with_options_native(
        endpoint: String,
        roots_der: Array<Array<Byte>>,
        allow_tls12: Boolean,
        protocols: Array<String>,
    ): Result<UInt64, TLSError> {
        return Error(TLSError.InvalidConfiguration);
    }

    private static connect_with_client_identity_native(
        endpoint: String,
        roots_der: Array<Array<Byte>>,
        client_certificate_chain_der: Array<Array<Byte>>,
        client_private_key_der: Array<Byte>,
        allow_tls12: Boolean,
        protocols: Array<String>,
    ): Result<UInt64, TLSError> {
        return Error(TLSError.InvalidConfiguration);
    }

    private static read_native(handle: UInt64, max_bytes: UInt64): TLSReadResult<Array<Byte>> {
        return TLSReadResult.Error(TLSError.Closed);
    }

    private static write_all_native(handle: UInt64, bytes: Array<Byte>): Result<Void, TLSError> {
        return Error(TLSError.Closed);
    }

    private static shutdown_native(handle: UInt64): Result<Void, TLSError> {
        return Error(TLSError.Closed);
    }

    private static close_native(handle: UInt64): Result<Void, TLSError> {
        return Error(TLSError.Closed);
    }

    private static is_closed_native(handle: UInt64): Boolean { return true; }

    private static peer_address_native(handle: UInt64): Result<String, TLSError> {
        return Error(TLSError.Closed);
    }

    private static negotiated_alpn_native(handle: UInt64): Result<String?, TLSError> {
        return Error(TLSError.Closed);
    }

    private static peer_certificate_sha256_native(handle: UInt64): Result<String?, TLSError> {
        return Error(TLSError.Closed);
    }

    private static connect_ok(value: TLSStream): Result<TLSStream, TLSError> { return Ok(value); }
    private static connect_error(error: TLSError): Result<TLSStream, TLSError> { return Error(error); }
    private static close_ok(): Result<Void, TLSResourceError> { return Ok(TLSStream.unit()); }
    private static close_error(error: TLSError): Result<Void, TLSResourceError> {
        return Error(TLSResourceError(error));
    }
    private static unit(): Void { return; }
}

// TLS server identities are explicit DER bytes. Binding uses the separate
// `network.listen.addresses` grant for the underlying numeric TCP address.
share class TLSListener implements Resource<TLSResourceError> {
    private inmut handle: UInt64;

    private construct(handle: UInt64) { this.handle = handle; }

    static bind(
        endpoint: String,
        certificate_chain_der: Array<Array<Byte>>,
        private_key_der: Array<Byte>,
        allow_tls12: Boolean,
    ): Result<TLSListener, TLSError> {
        return match TLSListener.bind_native(
            endpoint,
            certificate_chain_der,
            private_key_der,
            allow_tls12,
        ) {
            Ok(handle) => TLSListener.bind_ok(TLSListener(handle));
            Error(error) => TLSListener.bind_error(error);
        };
    }

    // Requires clients to present a certificate chained to one of the
    // explicitly supplied DER roots. TLS 1.2 remains opt-in.
    static bind_with_client_auth(
        endpoint: String,
        certificate_chain_der: Array<Array<Byte>>,
        private_key_der: Array<Byte>,
        client_roots_der: Array<Array<Byte>>,
        allow_tls12: Boolean,
    ): Result<TLSListener, TLSError> {
        return match TLSListener.bind_with_client_auth_native(
            endpoint,
            certificate_chain_der,
            private_key_der,
            client_roots_der,
            allow_tls12,
        ) {
            Ok(handle) => TLSListener.bind_ok(TLSListener(handle));
            Error(error) => TLSListener.bind_error(error);
        };
    }

    // Offers HTTP/2 and HTTP/1.1 ALPN identifiers for an HTTP server adapter.
    static bind_for_http(
        endpoint: String,
        certificate_chain_der: Array<Array<Byte>>,
        private_key_der: Array<Byte>,
        allow_tls12: Boolean,
    ): Result<TLSListener, TLSError> {
        return match TLSListener.bind_http_native(
            endpoint,
            certificate_chain_der,
            private_key_der,
            allow_tls12,
        ) {
            Ok(handle) => TLSListener.bind_ok(TLSListener(handle));
            Error(error) => TLSListener.bind_error(error);
        };
    }

    accept(): Result<TLSStream, TLSError> {
        return TLSListener.accept_native(this.handle);
    }

    // HTTP server adapter: wakes an idle TLS accept when the shared server
    // control requests shutdown; the listener remains caller-owned.
    accept_until_shutdown(control_handle: UInt64): Result<TLSStream, TLSError> {
        return TLSListener.accept_until_shutdown_native(this.handle, control_handle);
    }

    close(): Result<Void, TLSResourceError> {
        return match TLSListener.close_listener_native(this.handle) {
            Ok(_) => TLSListener.close_ok();
            Error(error) => TLSListener.close_error(error);
        };
    }

    is_closed(): Boolean {
        return TLSListener.is_listener_closed_native(this.handle);
    }

    private static bind_native(
        endpoint: String,
        certificate_chain_der: Array<Array<Byte>>,
        private_key_der: Array<Byte>,
        allow_tls12: Boolean,
    ): Result<UInt64, TLSError> {
        return Error(TLSError.PermissionDenied);
    }

    private static bind_http_native(
        endpoint: String,
        certificate_chain_der: Array<Array<Byte>>,
        private_key_der: Array<Byte>,
        allow_tls12: Boolean,
    ): Result<UInt64, TLSError> {
        return Error(TLSError.PermissionDenied);
    }

    private static bind_with_client_auth_native(
        endpoint: String,
        certificate_chain_der: Array<Array<Byte>>,
        private_key_der: Array<Byte>,
        client_roots_der: Array<Array<Byte>>,
        allow_tls12: Boolean,
    ): Result<UInt64, TLSError> {
        return Error(TLSError.PermissionDenied);
    }

    private static accept_native(handle: UInt64): Result<TLSStream, TLSError> {
        return Error(TLSError.Closed);
    }

    private static accept_until_shutdown_native(
        handle: UInt64,
        control_handle: UInt64,
    ): Result<TLSStream, TLSError> {
        return Error(TLSError.Closed);
    }

    private static close_listener_native(handle: UInt64): Result<Void, TLSError> {
        return Error(TLSError.Closed);
    }

    private static is_listener_closed_native(handle: UInt64): Boolean { return true; }

    private static bind_ok(listener: TLSListener): Result<TLSListener, TLSError> {
        return Ok(listener);
    }

    private static bind_error(error: TLSError): Result<TLSListener, TLSError> {
        return Error(error);
    }

    private static close_ok(): Result<Void, TLSResourceError> {
        return Ok(TLSListener.unit());
    }

    private static unit(): Void { return; }

    private static close_error(error: TLSError): Result<Void, TLSResourceError> {
        return Error(TLSResourceError(error));
    }
}
