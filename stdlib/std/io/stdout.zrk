share fn print(...args: String): Void { }

share fn println(...args: String): Void {
    mut output: String = "";
    mut first: Boolean = true;
    for arg in args {
        if !first {
            output = output + " ";
        }
        output = output + arg;
        first = false;
    }
    write_line(output);
}

fn write_line(text: String): Void { }

share fn flush(): Result<Void, IoError> { return Error(IoError.Io); }
