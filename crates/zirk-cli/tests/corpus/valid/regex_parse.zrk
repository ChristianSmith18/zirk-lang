import { stdout } from std.io;

fn main(): Void {
    mut ok: Result<Regex, RegexError> = Regex.parse("a.b");
    match ok {
        Ok(_) => stdout.println("ok");
        Error(_) => stdout.println("bad");
    }

    mut bad: Result<Regex, RegexError> = Regex.parse("[");
    match bad {
        Error(_) => stdout.println("err");
        Ok(_) => stdout.println("unexpected");
    }

    match ok {
        Ok(regex) => {
            stdout.println(regex.matches("aXb").to_string());
            stdout.println(regex.matches("ab").to_string());
        }
        Error(_) => { }
    }
}
