class ValidationError implements Throwable {
    inmut reason: String;

    construct(reason: String) {
        this.reason = reason;
    }

    #override
      message(): String {
        return this.reason;
    }

    #override
      code(): String {
        return "VALIDATION";
    }

    #override
      cause(): Error? {
        return null;
    }

    #override
      stack_trace(): StackTrace {
        return StackTrace();
    }
}

fn main(): Void {
    try {
        unsafe {
            mut local: Int32 = 1;
            local = 2;
            throw ValidationError("boom");
        }
    } catch ValidationError(e) {
        stdout.println(e.message());
    }
    stdout.println("done");
}
