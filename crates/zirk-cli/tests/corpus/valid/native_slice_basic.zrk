import { stdout } from std.io;

fn main(): Void {
    mut x: Int32 = 41;
    unsafe {
        mut p: Pointer<Int32> = Pointer.from (x);
        match p.as_slice_mut(1) {
            Ok(view) => {
                view[0] = 42;
                stdout.println(view[0].to_string());
                stdout.println(view.length.to_string());
                stdout.println(view.is_empty.to_string());
            }
            Error(_) => stdout.println("slice construction failed");
        }
    }
}
