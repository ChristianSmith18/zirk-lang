import { stdout } from std.io;

fn main(): Void {
    inmut value = { seed: "start" };
    value.status = "ok";
    value["count"] = 2;
    value.status;
    value["status"];
    value["count"];
    inmut count: Int32 = value["count"] as Int32;
    inmut maybe_text: String? = value["count"] as ? String;
    stdout.println("dynamic read succeeded: {count}, {maybe_text}");
}
main();
