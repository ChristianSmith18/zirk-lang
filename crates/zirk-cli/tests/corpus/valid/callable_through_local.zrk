fn double(n: Int32): Int32 {
    return n * 2;
}

fn apply(f: Fn(Int32) => Int32, n: Int32): Int32 {
    return f(n);
}

fn main(): Void {
    mut named = double;
    stdout.println(apply(named, 21));
    mut lam: Fn(Int32) => Int32 = (n: Int32): Int32 => n + 1;
    stdout.println(apply(lam, 20));
}
