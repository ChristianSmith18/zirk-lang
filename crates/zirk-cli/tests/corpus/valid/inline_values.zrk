import { stdout } from std.io;

// Named class values are managed references with identity; compact data uses
// tuples, while dynamic named data uses Object literals.
class Point {
    x: Int32;
    y: Int32;
    construct(x: Int32, y: Int32) { this.x = x; this.y = y; }
}

class Line {
    start: Point;
    end: Point;
    construct(start: Point, end: Point) { this.start = start; this.end = end; }
}

class Money {
    amount: Int32;
    currency: String;
    construct(amount: Int32, currency: String) { this.amount = amount; this.currency = currency; }
}

class Config {
    name: String;
    count: Int32;
    construct(name: String, count: Int32) { this.name = name; this.count = count; }
}

fn doubleMoney(m: Money): Money {
    return Money(m.amount * 2, m.currency);
}

fn main(): Void {
    mut point = Point(1, 2);
    stdout.println(point.x);
    stdout.println(point.y);

    mut line = Line(Point(0, 0), Point(3, 4));
    stdout.println(line.start.x);
    stdout.println(line.end.y);

    mut money = Money(100, "USD");
    mut doubled = doubleMoney(money);
    stdout.println(doubled.amount);
    stdout.println(doubled.currency);

    mut config = Config("x", 0);
    stdout.println(config.name);
    stdout.println(config.count);

    mut present: Point? = Point(7, 8);
    mut absent: Point? = null;
    stdout.println(present?.x ?? 0);
    stdout.println(absent?.x ?? 0);
}
