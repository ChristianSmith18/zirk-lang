// Un parámetro de tipo con default se usa cuando se omite el argumento.
class Box<T = Int32> {
    value: T;
    construct(value: T) { this.value = value; }
    fn get(): T { return this.value; }
}

fn main(): Void {
    mut b = Box(7);
    stdout.println(b.get());

    mut s: Box<String> = Box("ok");
    stdout.println(s.get());

    mut d: Box<> = Box(5);
    stdout.println(d.get());
}
