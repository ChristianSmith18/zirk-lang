fn main(): Void {
    mut a: Int8 = 1;
    stdout.println((a as Int32) == 1);

    mut b: Float16 = 1.0;
    stdout.println((b as Float64) == 1.0);

    mut c: Float = 1;
    stdout.println(c == 1.0);

    mut d: Int = 1.0;
    stdout.println(d == 1);

    mut e: Float128 = 1.0;

    stdout.println("ok");
}
