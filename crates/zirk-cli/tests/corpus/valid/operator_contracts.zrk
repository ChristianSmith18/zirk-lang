class Money {
    amount: Int32;

    construct(amount: Int32) { this.amount = amount; }

    // El contrato de operador: `+` sobre un tipo propio.
    fn _add(other: Money): Money { return Money(this.amount + other.amount); }
}

fn main(): Void {
    // La deuda de la Fase 2, cerrada.
    stdout.println("hello" + " " + "world");

    stdout.println("ja" * 3);
    stdout.println(3 * "ja");
    stdout.println("nada" * 0);

    mut total = Money(30) + Money(12);
    stdout.println(total.amount);
}
