class Point {
    x: Int32;
    construct(x: Int32) { this.x = x; }
    fn _equals(other: Point): Boolean { return this.x == other.x; }
}
fn main(): Void {
    mut a = Point(1);
    mut b = Point(1);
    mut alias = a;
    stdout.println(a == b);
    stdout.println(a is b);
    stdout.println(a is alias);
    stdout.println("x" is "x");
}
