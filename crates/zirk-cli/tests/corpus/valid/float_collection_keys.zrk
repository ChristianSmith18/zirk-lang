import { stdout } from std.io;

fn main(): Void {
    mut values: Map<Float64, Int32> = Map();
    values.set(0.0 as Float64, 1);
    values.set((-0.0) as Float64, 2);
    stdout.println(values.length.to_string());
    stdout.println((values.get(0.0 as Float64) ?? 0).to_string());

    mut elements: Set<Float64> = Set();
    elements.add(0.0 as Float64);
    elements.add((-0.0) as Float64);
    stdout.println(elements.length.to_string());

    mut wide_values: Map<Float128, Int32> = Map();
    wide_values.set(0.0 as Float128, 3);
    wide_values.set((-0.0) as Float128, 4);
    stdout.println(wide_values.length.to_string());
    stdout.println((wide_values.get(0.0 as Float128) ?? 0).to_string());
}

main();
