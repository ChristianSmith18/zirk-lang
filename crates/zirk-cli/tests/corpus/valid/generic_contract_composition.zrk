interface A<T> {
     get(): T;
}

interface B<T> implements A<T> {
     extra(): T;
}

class C<T> implements B<T> {
    value: T;
    construct(v: T) { this.value = v; }
     get(): T { return this.value; }
     extra(): T { return this.value; }
}

fn main(): Void {
    mut c: C<Int32> = C(7);
    stdout.println(c.get());
    stdout.println(c.extra());
}
