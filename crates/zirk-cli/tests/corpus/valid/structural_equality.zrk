import { stdout } from std.io;

// Object and class equality follows shared reference identity. Structural
// equality is not implicit; compare fields or define an explicit operation.
class Point {
    x: Int32;
    y: Int32;
    construct(x: Int32, y: Int32) {
        this.x = x;
        this.y = y;
    }
}

fn main(): Void {
    mut first = Point(1, 2);
    mut alias = first;
    mut equal_fields = Point(1, 2);
    stdout.println(first is alias);
    stdout.println(first is equal_fields);

    mut open: Object = { x: 1, y: 2 };
    mut object_alias: Object = open;
    mut another: Object = { x: 1, y: 2 };
    stdout.println(open is object_alias);
    stdout.println(open is another);
}
main();
