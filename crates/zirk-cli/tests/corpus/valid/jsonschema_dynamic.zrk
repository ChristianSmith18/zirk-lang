import { JSON } from std.json;
import { stdout } from std.io;

fn main(): Void {
    try {
        inmut schema: String = "\{\"type\":\"object\",\"required\":[\"name\"],\"properties\":\{\"name\":\{\"type\":\"string\"\}\}\}";
        inmut valid: Dynamic = JSON.parse("\{\"name\":\"Ada\"\}");
        inmut valid_issues: List<Dynamic> = JSON.validate(valid, schema);
        stdout.println(valid_issues.length);

        inmut invalid: Dynamic = JSON.parse("\{\"name\":7\}");
        inmut invalid_issues: List<Dynamic> = JSON.validate(invalid, schema);
        stdout.println(invalid_issues.length);
        stdout.println(JSON.stringify(invalid_issues[0]));

        inmut reference_schema: String = "\{\"$ref\":\"https://schemas.example.test/name.json\"\}";
        inmut resources: Dynamic = JSON.parse("\{\"https://schemas.example.test/name.json\":\{\"type\":\"string\"\}\}");
        inmut resolved_valid: List<Dynamic> = JSON.validate_with_resolver(
            JSON.parse("\"Ada\""),
            reference_schema,
            resources,
        );
        stdout.println(resolved_valid.length);
        inmut resolved_invalid: List<Dynamic> = JSON.validate_with_resolver(
            JSON.parse("7"),
            reference_schema,
            resources,
        );
        stdout.println(resolved_invalid.length);
        stdout.println(JSON.stringify(resolved_invalid[0]));
    } catch JsonConversionError(error) {
        stdout.println(error.message());
    }
}

main();
