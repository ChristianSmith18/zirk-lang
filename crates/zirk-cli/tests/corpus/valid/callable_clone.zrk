class Counter {
    mut value: Int32;
    construct(value: Int32) { this.value = value; }
    fn inc(n: Int32): Int32 {
        this.value = this.value + n;
        return this.value;
    }
}

fn main(): Void {
    mut c = Counter(0);
    inmut inc = (n: Int32): Int32 => c.inc(n);
    inmut inc_clone = inc.clone();
    stdout.println(inc(5));
    stdout.println(inc(5));
    stdout.println(inc_clone(1));
    stdout.println(inc_clone(2));
    stdout.println(inc(2));
}
