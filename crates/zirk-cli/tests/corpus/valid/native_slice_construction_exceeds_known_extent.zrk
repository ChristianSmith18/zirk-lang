// `pointer.as_slice(length)` with a `length` that exceeds the real
// underlying allocation returns `Error`, not a view that would allow
// out-of-bounds reads (roadmap Phase 4e, `fase-4e-native-slice`, design D3).
//
// `Pointer.from(x).as_slice(2)`, written directly like this, is the one
// shape this pass's own scope decision can cross-check against a real,
// statically-known extent: `x`'s own storage holds exactly one `Int32`, so
// asking for two is provably out of range.
fn main(): Void {
    mut x: Int32 = 1;
    unsafe {
        mut r: Result<NativeSlice<Int32>, NativeError> = Pointer.from(x).as_slice(2);
        match r {
            Result.Ok(view) => stdout.println("ok: " + view.length.to_string());
            Result.Error(e) => stdout.println("error: " + e.message());
        }
    }
}
