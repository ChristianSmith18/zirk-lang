// Los operadores de comparación se resuelven por los métodos reservados _less etc.
class Money {
    amount: Int32;
    construct(amount: Int32) { this.amount = amount; }
     _less(other: Money): Boolean { return this.amount < other.amount; }
}

fn main(): Void {
    mut a = Money(3);
    mut b = Money(5);
    stdout.println(a < b);
}
