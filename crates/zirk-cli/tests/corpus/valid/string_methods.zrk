// `String` built-in methods and `Char` classification/normalization.
fn main(): Void {
    inmut s = "  hello  ";
    stdout.println(s.trim());
    stdout.println(s.contains("ell"));
    stdout.println(s.starts_with("  "));
    stdout.println(s.ends_with("  "));
    stdout.println(s.substring(2, 5));
    stdout.println(s.search("lo"));
    stdout.println(((s.find("lo")) ?? Int64(-1)).to_string());
    stdout.println(((s.find("missing")) ?? Int64(-1)).to_string());
    stdout.println(s.replace("hello", "Zirk"));
    stdout.println(s.trim_start());
    stdout.println(s.trim_end());
    stdout.println(s.to_lowercase());
    stdout.println(s.to_uppercase());
    stdout.println(s.normalize("NFC"));
    stdout.println(s.is_empty().to_string());
    stdout.println(s.split_whitespace().to_string());
    stdout.println("a\nb\nc".lines().to_string());
    stdout.println("abc".bytes().to_string());
    stdout.println("abc".codepoints().to_string());
    stdout.println("abc".chars().to_string());
    stdout.println(s.clone());
    inmut c = 'A';
    stdout.println(c.is_uppercase());
    stdout.println(c.is_lowercase());
    stdout.println(c.is_letter());
    stdout.println(c.is_digit());
    stdout.println(c.is_whitespace());
    stdout.println(c.to_uppercase());
    stdout.println('Z'.to_lowercase());
    inmut parts = "a,b,c".split(",");
    for p in parts { stdout.println(p); }
    inmut chars = "abc".split("");
    for ch in chars { stdout.println(ch); }
}
