import { stdout } from std.io;

contract Container<T> {
    get(): T;
}

class Pair<T> implements Container<T> {
    value: T;
    construct(value: T) { this.value = value; }
    get(): T { return this.value; }
}

fn value_int(c: Container<Int32>): Int32 { return c.get(); }
fn value_str(c: Container<String>): String { return c.get(); }

fn main(): Void {
    mut i: Pair<Int32> = Pair(5);
    mut s: Pair<String> = Pair("hello");
    stdout.println(value_int(i));
    stdout.println(value_str(s));
}
