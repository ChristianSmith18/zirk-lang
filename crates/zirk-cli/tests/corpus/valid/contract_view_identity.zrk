import { stdout } from std.io;

// A class keeps the same reference identity through repeated contract views.
contract Describable {
    describe(): String;
}

class Point implements Describable {
    x: Int32;
    construct(x: Int32) { this.x = x; }
    describe(): String { return "a point"; }
}

fn main(): Void {
    mut p = Point(1);
    mut a: Describable = p;
    mut b: Describable = p;
    stdout.println(a is b);
    stdout.println(a is a);
}
