import { stdout } from std.io;

// Class methods retain identity and dispatch through their class descriptor.
class Point {
    x: Int32;
    y: Int32;
    construct(x: Int32, y: Int32) { this.x = x; this.y = y; }
    lengthSquared(): Int32 { return this.x * this.x + this.y * this.y; }
}

fn main(): Void {
    inmut p = Point(3, 4);
    stdout.println(p.lengthSquared());
}
