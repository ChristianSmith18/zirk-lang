import { stdout } from std.io;

fn main() {
    stdout.println(TimeZone.database_version());
    stdout.println((match TimeZone.parse("US/Eastern") {
        Ok(zone) => zone.canonical_identifier;
        Error(_) => "<error>";
    }) == "America/New_York");
    stdout.println((match TimeZone.parse("America/New_York") {
        Ok(zone) => zone.canonical_identifier;
        Error(_) => "<error>";
    }) == "America/New_York");
    match TimeZone.parse("America/New_York") {
        Ok(zone) => {
            match Instant.parse("2024-01-15T12:00:00Z") {
                Ok(winter) => {
                    stdout.println(zone.offset_seconds_at(winter));
                    stdout.println(zone.is_dst_at(winter));
                    stdout.println(zone.abbreviation_at(winter));
                }
                Error(_) => stdout.println("instant parse failed");
            };
            match Instant.parse("2024-07-15T12:00:00Z") {
                Ok(summer) => {
                    stdout.println(zone.offset_seconds_at(summer));
                    stdout.println(zone.is_dst_at(summer));
                    stdout.println(zone.abbreviation_at(summer));
                }
                Error(_) => stdout.println("instant parse failed");
            };
        }
        Error(_) => stdout.println("zone parse failed");
    };
    stdout.println((match TimeZone.parse("+05:30") {
        Ok(zone) => zone.canonical_identifier;
        Error(_) => "<error>";
    }) == "+05:30");
    stdout.println(match TimeZone.parse("+24:00") {
        Ok(_) => "accepted invalid offset";
        Error(_) => "rejected invalid offset";
    });

    stdout.println(match TimeZone.parse("Mars/Olympus") {
        Ok(_) => "accepted unknown zone";
        Error(_) => "rejected unknown zone";
    });
}

main();
