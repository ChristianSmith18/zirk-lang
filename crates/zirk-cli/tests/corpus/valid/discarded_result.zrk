// A `Result<T,E>` produced by a statement and never consumed is a
// compile-time error (roadmap Phase 4a,
// `docs/ERROR_RESOURCE_PERMISSION_SEMANTICS.md` section 2). `_ = load();`
// would be the explicit escape hatch.
fn load(): Result<Int32, String> {
    return Ok(5);
}

fn main(): Void {
    load();
}
