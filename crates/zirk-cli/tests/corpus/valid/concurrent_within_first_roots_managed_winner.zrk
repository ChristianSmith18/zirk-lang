import { stdout } from std.io;
class Payload {
    text: String;
    construct(text: String) { this.text = text; }
}
fn main(): Void {
    mut winner: Payload = Concurrent.of(
        (): Payload => Payload("rooted value"),
        (): Payload => {
        try {
            Timer.sleep(50ms);
            return Payload("late value");
        } finally {
            mut churn: List<Int32> = [0 .. 4096];
        }
        return Payload("unreachable");
    },
    ).within(1s).first(

    );
    stdout.println(winner.text);
}
