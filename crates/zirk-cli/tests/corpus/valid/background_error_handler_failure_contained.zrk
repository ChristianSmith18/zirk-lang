import { stdout } from std.io;

fn handle_background_error(error: Throwable): Void throws InvalidArgumentError {
    stdout.println("handler-called");
    throw InvalidArgumentError("handler failure");
}

fn fail_in_background(): Void throws InvalidArgumentError {
    throw InvalidArgumentError("detached failure");
}

fn main(): Void {
    App.on_background_error = handle_background_error;
    Concurrent.detach(fail_in_background);
    Timer.sleep(2ms);
}
