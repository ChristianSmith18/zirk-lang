import { stdout } from std.io;

class CleanupFailure implements Throwable {
    construct() { }
    message(): String { return "cleanup failed"; }
    code(): String { return "CLEANUP_FAILURE"; }
    cause(): Error? { return null; }
    stack_trace(): StackTrace { return StackTrace(); }
}

fn cleanup(): Void throws CleanupFailure {
    throw CleanupFailure();
}

fn main(): Void {
    try {
        mut winner: Int32 = Concurrent.of(
            (): Int32 => {
            Timer.sleep(150ms);
            return 1;
        },
            (): Int32 => {
            stdout.println("loser started");
            try { Timer.sleep(500ms); } finally {
                stdout.println("cleanup ran");
                cleanup();
            }
            return 2;
        },
        ).first();
        stdout.println(winner);
    } catch CleanupFailure(_) {
        stdout.println("cleanup failure propagated");
    }
}
