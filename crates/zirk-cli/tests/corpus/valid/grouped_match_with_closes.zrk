class OpenError implements Error {
    inmut reason: String;

    construct(reason: String) {
        this.reason = reason;
    }

    override fn message(): String {
        return this.reason;
    }

    override fn code(): String {
        return "OPEN";
    }

    override fn cause(): Error? {
        return null;
    }
}

class FakeFile implements Resource<OpenError> {
    inmut name: String;
    mut closed: Boolean;

    construct(name: String) {
        this.name = name;
        this.closed = false;
    }

    fn read_all(): String {
        return "contents of " + this.name;
    }

    override fn close(): Result<Void, OpenError> {
        this.closed = true;
        stdout.println("closed " + this.name);
        return Ok(this.nothing());
    }

    fn nothing(): Void {
        return;
    }

    override fn is_closed(): Boolean {
        return this.closed;
    }
}

fn open_file(name: String, fail: Boolean): Result<FakeFile, OpenError> {
    if fail {
        return Error(OpenError("cannot open " + name));
    }
    return Ok(FakeFile(name));
}

fn main(): Void {
    match open_file("a", false) with a, open_file("b", false) with b {
        stdout.println(a.read_all());
        stdout.println(b.read_all());
    }
    stdout.println("done");
}
