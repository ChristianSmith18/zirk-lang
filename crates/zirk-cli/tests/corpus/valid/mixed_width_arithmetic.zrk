fn main(): Void {
    mut a: Int8 = 1;
    mut b: Int32 = 2;
    mut c = a + b;
    stdout.println(c == 3);

    mut u: UInt8 = 5 as UInt8;
    mut v: Int32 = -2;
    mut w = u + v;
    stdout.println(w == 3.0);

    mut x: Int32 = 2;
    mut y: BinaryFloat64 = 1.5;
    mut z = x + y;
    stdout.println(z == 3.5);

    mut n: Int8 = 3;
    mut s = "x" * n;
    stdout.println(s == "xxx");

    mut i: Int8 = 5;
    i++;
    stdout.println((i as Int32) == 6);
}
