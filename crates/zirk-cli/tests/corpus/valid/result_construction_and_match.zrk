// `Result<T,E>` (roadmap Phase 4a, `docs/ERROR_RESOURCE_PERMISSION_SEMANTICS.md`
// section 2): construction (`Ok(...)`/`Error(...)`), destructuring
// `match`, and the seven in-scope methods (`get_or_else` and the four
// generic combinators are out of scope for this pass).
fn divide(a: Int32, b: Int32): Result<Int32, String> {
    if b == 0 {
        return Error("division by zero");
    }
    return Ok(a / b);
}

fn describe(r: Result<Int32, String>): String {
    return match r {
        Ok(value) => "ok:" + value.to_string();
        Error(error) => "error:" + error;
    };
}

fn main(): Void {
    mut ok: Result<Int32, String> = divide(10, 2);
    mut error: Result<Int32, String> = divide(10, 0);

    stdout.println(describe(ok));
    stdout.println(describe(error));

    stdout.println(ok.is_ok());
    stdout.println(ok.is_error());
    stdout.println(error.is_ok());
    stdout.println(error.is_error());

    stdout.println(ok.ok_or_null() ?? -1);
    stdout.println(error.ok_or_null() ?? -1);
    stdout.println(ok.error_or_null() ?? "none");
    stdout.println(error.error_or_null() ?? "none");

    stdout.println(ok.get_or(-1));
    stdout.println(error.get_or(-1));

    stdout.println(ok.unwrap());
    stdout.println(error.unwrap_error());

    // Mandatory consumption: a `Result` produced by a statement and never
    // matched or checked is a compile-time error; `_ = expr;` is the
    // explicit discard that opts out.
    _ = divide(1, 0);
}
