import { stdout } from std.io;

fn divide(a: Int32, b: Int32): Result<Int32, String> {
    if b == 0 {
        return Error("division by zero");
    }
    return Ok(Int32(a / b));
}

fn describe(r: Result<Int32, String>): String {
    return match r {
        Ok(value) => "ok:" + value.to_string();
        Error(error) => "error:" + error;
    };
}

fn nested(): Result<Result<Int32, String>, String> {
    mut inner: Result<Int32, String> = Ok(7);
    return Ok(inner);
}

fn main(): Void {
    mut ok: Result<Int32, String> = divide(10, 2);
    mut error: Result<Int32, String> = divide(10, 0);

    stdout.println(describe(ok));
    stdout.println(describe(error));

    stdout.println(match ok { Ok(_) => true; Error(_) => false; });
    stdout.println(match ok { Ok(_) => false; Error(_) => true; });
    stdout.println(match error { Ok(_) => true; Error(_) => false; });
    stdout.println(match error { Ok(_) => false; Error(_) => true; });

    stdout.println(ok ?? - 1);
    stdout.println(error ?? - 1);
    stdout.println(nested());
    stdout.println(match ok { Ok(_) => "none"; Error(value) => value; });
    stdout.println(match error { Ok(_) => "none"; Error(value) => value; });

    stdout.println(match ok { Ok(value) => value; Error(_) => -1; });
    stdout.println(match error { Ok(value) => value; Error(_) => -1; });

    stdout.println(match ok { Ok(value) => value; Error(_) => -1; });
    stdout.println(match error { Ok(_) => "unexpected"; Error(value) => value; });

    _ = divide(1, 0);
}
