// Una clase que se construye, lee sus campos y escribe los mutables.

class User {
    inmut id: Int32;
    name: String;

    construct(id: Int32, name: String) {
        this.id = id;
        this.name = name;
    }
}

class Counter {
    count: Int32;
    private step: Int32;

    // Varios `construct`: se resuelven por aridad.
    construct(start: Int32) { this.count = start; this.step = 1; }
    construct() { this.count = 0; this.step = 1; }

    fn bump(): Int32 {
        this.count = this.count + this.step;
        return this.count;
    }

    // Un método alcanza lo privado de su propia clase, y a otro por `this`.
    fn twice(): Int32 {
        this.bump();
        return this.bump();
    }
}

fn main(): Void {
    mut user = User(1, "Cristian");
    stdout.println(user.id);
    stdout.println(user.name);

    // El campo `mut` se puede reescribir; el `inmut` no.
    user.name = "otro";
    stdout.println(user.name);

    mut from_zero = Counter();
    mut from_ten = Counter(10);
    stdout.println(from_zero.count);
    stdout.println(from_ten.count);

    stdout.println(from_zero.bump());
    stdout.println(from_zero.twice());

    // Dos objetos distintos no comparten estado.
    mut a = User(1, "a");
    mut b = User(2, "b");
    a.name = "cambiado";
    stdout.println(b.name);
}
