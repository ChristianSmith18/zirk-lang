import { stdout } from std.io;

enum Direction { North, South, East, West }
enum ExitCode { Success -> 0, Failure -> 1 }
enum HttpStatus { Ok -> "ok", NotFound -> "not-found" }

fn main(): Void {
    stdout.println(Direction.count);
    stdout.println(Enums.count(ExitCode));

    for name in Direction.keys() {
        stdout.println(name);
    }
    for name in Enums.keys(ExitCode) {
        stdout.println(name);
    }

    for d in Direction.values() {
        stdout.println(d.value);
        stdout.println(d.name);
    }
    for c in Enums.values(ExitCode) {
        stdout.println(c.value);
    }

    match Direction.from_name("East") {
        Ok(value) => stdout.println(value.value);
        Error(_) => stdout.println("miss");
    }
    match Direction.from_name("Up") {
        Error(_) => stdout.println("miss");
        Ok(_) => stdout.println("unexpected");
    }

    match ExitCode.from_value(1) {
        Ok(value) => stdout.println(value.name);
        Error(_) => stdout.println("unexpected");
    }
    match Direction.from_value(2) {
        Ok(value) => stdout.println(value.name);
        Error(_) => stdout.println("unexpected");
    }
    match ExitCode.from_value(99) {
        Error(_) => stdout.println("miss");
        Ok(_) => stdout.println("unexpected");
    }
    match HttpStatus.from_value("not-found") {
        Ok(value) => stdout.println(value.name);
        Error(_) => stdout.println("unexpected");
    }

    stdout.println(Direction.to_string());
    stdout.println(Direction.to_string);
}
