fn main(): Void {
    inmut values: List<Int32> = [3, 1, 2];
    stdout.println(values.map((x: Int32): Int32 => x * 2).sum());
    stdout.println(values.filter((x: Int32): Boolean => x > 1).count());
    stdout.println(values.reduce(0, (a: Int32, b: Int32): Int32 => a + b));
    stdout.println(values.reduce_ordered(0, (a: Int32, b: Int32): Int32 => a - b));
    values.sort();
    stdout.println(values.first() ?? 0);
    stdout.println(values.last() ?? 0);
    stdout.println(values.contains(2));
    inmut fixed: Array<Int32> = [1, 2, 3];
    stdout.println(fixed.map((x: Int32): Int32 => x * 3).sum());
    stdout.println((1..=3).map((x: Int32): Int32 => x * x).collect().count());
    inmut pair = (1, "x");
    stdout.println(pair.to_string());
}
