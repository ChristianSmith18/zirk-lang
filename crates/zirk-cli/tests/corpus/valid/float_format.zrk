// Float.format(spec) for BinaryFloat32/BinaryFloat64/BinaryFloat16/BinaryFloat128.
fn main(): Void {
    mut x: BinaryFloat64 = 3.14159265;
    stdout.println(x.format(".2"));
    stdout.println(x.format("8.2"));
    stdout.println(x.format("08.2"));
    stdout.println(x.format("e"));
    stdout.println(x.format("10.4e"));

    mut y: BinaryFloat32 = 2.5;
    stdout.println(y.format(".3"));

    mut z: BinaryFloat16 = 1.25;
    stdout.println(z.format(".2"));

    mut w: BinaryFloat128 = 1234.5;
    stdout.println(w.format(".2"));

    stdout.println((-1234.5b).format(".2"));
    stdout.println((1234567.0b).format(".2e"));
}
