import { stdout } from std.io;

// A trait's default body can omit the annotation too: the adopter copies
// the resolved signature.
trait Labelled {
    label(): String;
    shout() { return this.label() + "!"; }
}

class User implements Labelled {
    name: String;
    construct(name: String) { this.name = name; }
    label(): String { return this.name; }
}

fn main() {
    mut u = User("zirk");
    stdout.println(u.shout());
}
