fn main(): Void {
    mut arr: Array<Int32> = Array(10, 20, 30, 40);
    stdout.println(arr[-1].to_string());
    stdout.println(arr[-4].to_string());

    mut l: List<Int32> = List(1, 2, 3);
    stdout.println(l[-1].to_string());
    l.insert(-1, 99);
    stdout.println(l[-2].to_string());

    stdout.println("hola"[-1]);
}
