// Selección explícita del default de un trait con TraitName.super.
trait Greeter {
     greet(): String;
     buildGreeting(): String { return "hello"; }
}

class Person implements Greeter {
    name: String;
    construct(name: String) { this.name = name; }
     greet(): String { return "hi, " + this.name; }
    #override
     buildGreeting(): String { return Greeter.super.buildGreeting() + " " + this.name; }
}

fn main(): Void {
    mut p = Person("world");
    stdout.println(p.buildGreeting());
}
