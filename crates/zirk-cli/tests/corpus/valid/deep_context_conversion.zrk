// Deep contextual conversion (`ZIRK_LANGUAGE_SPEC.md` section 3, roadmap
// Phase 3b, task 7): `Float(3 / 4)` converts each leaf before the division
// runs, yielding `0.75` — not `(3 / 4) as Float`, which would divide as
// `Int32` first and convert the already-truncated `0` after.
fn half(n: Int32): Int32 {
    return n / 2;
}

fn main(): Void {
    // Literal leaves.
    mut a: BinaryFloat64 = BinaryFloat64(3 / 4);
    stdout.println(a == 0.75);

    // Variable leaves, same rule.
    mut b: Int32 = 3;
    mut c: Int32 = 4;
    mut d: BinaryFloat64 = BinaryFloat64(b / c);
    stdout.println(d == 0.75);

    // `String("x=" + 42)`: the integer converts to text before
    // concatenating, not the other way around.
    mut s: String = String("x=" + 42);
    stdout.println(s == "x=42");

    // The context reaches any numeric target, not only `Float` — an
    // addition that would overflow `Int32` succeeds once each leaf is
    // widened to `Int64` before adding.
    mut wide: Int64 = Int64(2000000000 + 2000000000);
    stdout.println(wide);

    // Unary `-` is part of the compatible tree too.
    mut neg: BinaryFloat64 = BinaryFloat64(-3 / 4);
    stdout.println(neg == -0.75);

    // A call is always a boundary: `half(3)` computes `3 / 2 = 1` as its
    // own declared `Int32`, untouched by the surrounding context — only the
    // *result* is converted, at the boundary, before the addition.
    mut boundary: BinaryFloat64 = BinaryFloat64(half(3) + 0.5);
    stdout.println(boundary == 1.5);
}
