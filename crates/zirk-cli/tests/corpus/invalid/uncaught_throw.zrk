// An explicit exception must be caught or declared (roadmap Phase 4b,
// `docs/ERROR_RESOURCE_PERMISSION_SEMANTICS.md` section 3).
class BoomError implements RuntimeError {
    construct() { }

    #override
      message(): String {
        return "boom";
    }

    #override
      code(): String {
        return "BOOM";
    }

    #override
      cause(): Error? {
        return null;
    }

    #override
      stack_trace(): StackTrace {
        return StackTrace();
    }
}

fn main(): Void {
    throw BoomError();
}
