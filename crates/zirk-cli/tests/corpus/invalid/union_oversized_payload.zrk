type Pair = Tuple<Int128, Int128>;
type Level1 = Tuple<Pair, Pair>;
type Level2 = Tuple<Level1, Level1>;
type Level3 = Tuple<Level2, Level2>;
type Level4 = Tuple<Level3, Level3>;
type Level5 = Tuple<Level4, Level4>;
type Level6 = Tuple<Level5, Level5>;
type Level7 = Tuple<Level6, Level6>;
type Level8 = Tuple<Level7, Level7>;
enum Huge { Big(value: Level8), Small }
type Oversized = Huge | Int32;
fn consume(value: Oversized): Void {}
fn main(): Void {}
