// A record or value class implementing a contract type-checks (conformance
// is verified the same way it is for a class), but it has no descriptor to
// carry the contract's own table — dispatching through the contract type
// would need one — so its own declaration is `NOT_LOWERED`. Its methods
// still dispatch statically when called directly on the concrete type
// (`value_class_methods.zrk`); what is missing is only the path from a
// contract-typed reference back to the value.
interface Describable {
    fn describe(): String;
}

record Point implements Describable {
    x: Int32;
    fn describe(): String { return "a point"; }
}

fn main(): Void {
    mut p = Point(x: 1);
    stdout.println(p.describe());
}
