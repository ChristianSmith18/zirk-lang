// A resource that does not implement `TransferableResource` cannot be moved
// with `transfer(...)`.

class OpenError implements Error {
    inmut reason: String;

    construct(reason: String) {
        this.reason = reason;
    }

    override fn message(): String {
        return this.reason;
    }

    override fn code(): String {
        return "OPEN";
    }

    override fn cause(): Error? {
        return null;
    }
}

class StuckFile implements Resource<OpenError> {
    inmut name: String;

    construct(name: String) {
        this.name = name;
    }

    fn nothing(): Void {
        return;
    }

    override fn close(): Result<Void, OpenError> {
        return Ok(this.nothing());
    }

    override fn is_closed(): Boolean {
        return false;
    }
}

fn open_file(name: String): Result<StuckFile, OpenError> {
    return Ok(StuckFile(name));
}

fn main(): Void {
    match open_file("x") with f {
        Ok(f) => {
            mut moved = transfer(f);
        }
        Error(_) => { }
    }
}
