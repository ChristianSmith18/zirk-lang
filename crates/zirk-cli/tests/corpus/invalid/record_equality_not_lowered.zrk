// `==`/`!=` on a record or value class type-checks without `_equals`
// (structural equality is derived, per the language spec), but lowering the
// comparison itself does not exist yet (roadmap task 11.5).
record Point { x: Int32; y: Int32; }

fn main(): Void {
    mut a = Point(x: 1, y: 2);
    mut b = Point(x: 1, y: 2);
    if a == b {
        stdout.println("eq");
    }
}
