// Ejecuta con:
// zirk run examples/task_await_demo.zrk

fn multiply(value: Int32, factor: Int32): Int32 {
    return value * factor;
}

fn announce_completion(): Void {
    stdout.println("la tarea sin resultado tambien termino");
}

fn main(): Void {
    // `base` se captura en la tarea y el resultado se consume una vez con await.
    mut base: Int32 = 21;
    mut doubled: Task<Int32> = task multiply(base, 2);
    stdout.println(await doubled);

    // Tambien funciona una tarea con bloque y return inferido.
    mut from_block = task { return 7; };
    stdout.println(await from_block);

    // El descarte debe ser explicito; el executor igual espera su finalizacion.
    _ = task announce_completion();
}
