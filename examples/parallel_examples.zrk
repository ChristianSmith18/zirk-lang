// Normative examples for `parallel-cpu-regions`: the `parallel { }` region,
// its `cores` option, real work-splitting for a `for` loop over a `List`,
// the `.parallel` adapter, and the region-boundary and no-I/O rules a
// `parallel` region enforces.
//
// Ordered `map`/`filter`, `for_each`, associative `reduce`, `sum`, and
// `Parallel.each` dispatch their per-element work to the same pool. Results
// that materialize a collection preserve the original input order.
//
// Run: `zirk run examples/parallel_examples.zrk`

fn compress(name: Int32): Int32 {
    return name * name;
}

fn main(): Void {
    // 1. A `parallel { for x in coll { ... } }` region: real work-splitting
    //    across the worker pool (`crates/zirk-runtime/src/pool.rs`) when the
    //    loop body has no `return`/`break`/`continue`/`throw` and does not
    //    reassign a captured name. The region boundary forbids capturing a
    //    `mut` reference type, so `files` is shared `inmut::strict`.
    inmut::strict files: List<Int32> = [1, 2, 3, 4, 5, 6, 7, 8];
    parallel {
        for name in files {
            compress(name);
        }
    }
    stdout.println("compressed");

    // 2. The `cores` option: an exact count and a runtime-picked range both
    //    resolve safely regardless of how many cores this machine has.
    parallel; cores: 2 {
        for name in files {
            compress(name);
        }
    }
    parallel; cores: 1..=4 {
        for name in files {
            compress(name);
        }
    }
    stdout.println("cores option ok");

    // 3. `parallel { }` used where a value is expected types as its final
    //    expression.
    inmut total: Int32 = parallel { compress(6) };
    stdout.println(total);

    // 4. A collection pipeline outside a region uses the `.parallel` adapter.
    inmut doubled: List<Int32> = files.parallel.map((n: Int32): Int32 => n * 2);
    inmut even: List<Int32> = doubled.parallel.filter((n: Int32): Boolean => n % 4 == 0);
    stdout.println(even.sum());

    // 5. `Parallel.each` is ordered even though callbacks finish independently.
    inmut shifted: List<Int32> = Parallel.each(files, (n: Int32): Int32 => n + 1);
    stdout.println(shifted[0]);
    stdout.println(shifted[7]);
}
