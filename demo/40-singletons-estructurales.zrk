// DEMO 40 — Valores compuestos como tipos singleton y comparación estructural.
// Se valida con `zirk check`; algunas formas compuestas aún tienen límites de
// ejecución nativa según docs/init/ZIRK_FEATURE_STATUS.md.

type Coordinates = Tuple<Int32, Tuple<Boolean, String>>;

type EnabledConfig = { enabled: true; retries: 3 };
type DisabledConfig = { enabled: false; retries: 0 };
type Config = EnabledConfig | DisabledConfig;
