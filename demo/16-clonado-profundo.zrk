// DEMO 16 — clone de records y objetos administrados con preservación de valores.
// Esta muestra está tomada de una forma cubierta por el corpus ejecutable del compilador.

import { stdout } from std.io;

class Tag {
    label: String;
    construct(label: String) { this.label = label; }
}

record Point {
    x: Int32;
    y: Int32;
    name: String;
    tag: Tag;
}

fn main(): Void {
    inmut p = Point(x: 1, y: 2, name: "hi", tag: Tag("t"));
    inmut q = p.clone();
    stdout.println(p.x);
    stdout.println(q.x);
    stdout.println(q.name);
    stdout.println(p.tag.label);
    stdout.println(q.tag.label);
    stdout.println(q.tag is p.tag);
}
