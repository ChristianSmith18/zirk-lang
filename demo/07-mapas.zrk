// DEMO 07 — Colecciones clave-valor con claves admitidas por el runtime.

import { stdout } from std.io;

fn main(): Void {
    inmut m: Map<Int32, Int32> = Map();
    m.set(1, 10);
    m.set(2, 20);
    stdout.println(m.length);
    stdout.println(m.contains_key(1));
    stdout.println(m.contains_key(3));
    inmut a = m.get(1) ?? 0;
    stdout.println(a);
    inmut b = m.get(3) ?? 0;
    stdout.println(b);
    stdout.println(m.remove(1));
    stdout.println(m.length);
    stdout.println(m.remove(1));
}
