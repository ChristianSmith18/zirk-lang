// DEMO 08 — Colecciones de elementos únicos y operaciones de pertenencia.

import { stdout } from std.io;

fn main(): Void {
    inmut s: Set<Int32> = Set();
    s.add(1);
    s.add(2);
    s.add(1);
    stdout.println(s.length);
    stdout.println(s.contains(1));
    stdout.println(s.contains(3));
    stdout.println(s.remove(1));
    stdout.println(s.length);
    stdout.println(s.remove(1));
}
