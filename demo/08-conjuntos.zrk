// DEMO 08 — Colecciones de elementos únicos y operaciones de pertenencia.
// Esta muestra está tomada de una forma cubierta por el corpus ejecutable del compilador.

import { stdout } from std.io;

fn main(): Void {
    mut s: Set<Int32> = Set();
    s.add(1);
    s.add(2);
    s.add(1);
    stdout.println(s.length.to_string());
    stdout.println(s.contains(1).to_string());
    stdout.println(s.contains(3).to_string());
    stdout.println(s.remove(1).to_string());
    stdout.println(s.length.to_string());
    stdout.println(s.remove(1).to_string());
}
