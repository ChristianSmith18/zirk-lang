// DEMO 01 — Familias enteras con signo y sin signo, conversiones y operaciones bit a bit.

import { stdout } from std.io;

// `as` es un cast comprobado entre tipos relacionados. Las conversiones de
// valor entre familias numéricas usan el constructor del tipo de destino y
// comprueban el rango. Las ampliaciones seguras pueden inferirse desde el tipo
// esperado. Los operadores de bits y desplazamiento siguen el tipo del valor.
fn main(): Void {
    // Aritmética comprobada con un entero con signo de ancho reducido.
    inmut a = 100;
    inmut a8 = Int8(a);
    inmut b8 = Int8(20);
    stdout.println(a8 + b8);

    // Aritmética comprobada y comparación con enteros sin signo.
    inmut u8 = UInt8(200);
    inmut v8 = UInt8(50);
    stdout.println("type:", u8.type);
    stdout.println(u8 < v8);
    stdout.println(v8 < u8);

    // Ampliación segura implícita: Int32 -> Int64 -> Int128, sin cambiar el signo.
    inmut x64: Int64 = a;
    inmut y64 = Int64(3);
    inmut z64 = x64 * y64;
    stdout.println(z64);

    inmut w128: Int128 = z64;
    stdout.println(w128);

    // `-` requiere un ancho con signo; `~` y las operaciones de bits admiten ambos.
    inmut n = UInt32(10);
    stdout.println(n << 2);
    stdout.println(n >> 1);
    stdout.println(~a);

    // División y resto con comprobación.
    inmut p = Int64(100);
    inmut q = Int64(7);
    stdout.println(p / q);
    stdout.println(p % q);
}
