// DEMO 01 — Familias enteras con signo y sin signo, conversiones explícitas y operaciones bit a bit.
// Esta muestra está tomada de una forma cubierta por el corpus ejecutable del compilador.

import { stdout } from std.io;

// La familia completa de enteros permite declarar cada ancho y comprobar
// operaciones según el ancho y el signo. La ampliación segura implícita exige
// conservar el signo y no reducir el ancho; `as` permite conversiones
// explícitas que reducen el ancho o cambian el signo. Los operadores de bits
// y desplazamiento aceptan anchos distintos para el valor y el desplazamiento.
fn main(): Void {
    // Aritmética comprobada con un entero con signo de ancho reducido.
    mut a: Int32 = 100;
    mut a8 = a as Int8;
    mut b8 =(20 as Int32) as Int8;
    stdout.println((a8 + b8) as Int32);

    // Aritmética comprobada y comparación con enteros sin signo.
    mut u8: UInt8 = 200;
    mut v8: UInt8 = 50 as UInt8;
    stdout.println("type:", u8.type);
    stdout.println(u8 < v8);
    stdout.println(v8 < u8);

    // Ampliación segura implícita: Int32 -> Int64 -> Int128, sin cambiar el signo.
    mut x64: Int64 = a as Int64;
    mut y64: Int64 = 3;
    mut z64 = x64 * y64;
    stdout.println(z64 as Int32);

    mut w128: Int128 = z64 as Int128;
    stdout.println(w128 as Int32);

    // `-` requiere un ancho con signo; `~` y las operaciones de bits admiten ambos.
    mut n: UInt32 = 10 as UInt32;
    stdout.println((n << 2) as Int32);
    stdout.println((n >> 1) as Int32);
    stdout.println((~ a));

    // División y resto con comprobación.
    mut p: Int64 = 100 as Int64;
    mut q: Int64 = 7 as Int64;
    stdout.println((p / q) as Int32);
    stdout.println((p % q) as Int32);
}
