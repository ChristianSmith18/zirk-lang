// DEMO 24 — Selección por orden de finalización de Concurrent.of(...).first().
// Esta muestra está tomada de una forma cubierta por el corpus ejecutable del compilador.

import { stdout } from std.io;

fn main(): Void {
    inmut winner = Concurrent.of(
        (): Int32 => {
        Timer.sleep(20ms);
        return 1;
    },
        (): Int32 => 2,
    ).first(

    );
    stdout.println(winner);
}
