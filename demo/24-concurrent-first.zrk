// DEMO 24 — Selección por orden de finalización de Concurrent.of(...).first().

import { stdout } from std.io;

fn main(): Void {
    inmut winner = Concurrent.of(
        (): Int32 => {
        Timer.sleep(20ms);
        return 1;
    },
        (): Int32 => 2,
    ).first();
    stdout.println(winner);
}
