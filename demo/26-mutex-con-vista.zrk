// DEMO 26 — Mutex<T>.with y vista prestada protegida durante el callback.

import { stdout } from std.io;

fn main(): Void {
    mut mutex: Mutex<Int32> = Mutex(4);
    inmut result = mutex.with (
        (view: Int32): Int32 => {
        inmut old_value = view;
        view = 8;
        return old_value;
    },
    );
    stdout.println(result);
}
