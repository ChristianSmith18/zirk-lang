// DEMO 26 — Mutex<T>.with y vista prestada protegida durante el callback.
// Esta muestra está tomada de una forma cubierta por el corpus ejecutable del compilador.

import { stdout } from std.io;

record Inner {
    count: Int32;
}

record State {
    inner: Inner;
    label: String;
}

fn main(): Void {
    inmut mutex: Mutex<State> = Mutex(State(inner: Inner(count: 4), label: "re" + "tained"));
    inmut result = mutex.with (
        (view: State): Int32 => {
        inmut old_length = view.label.length;
        view = State(inner: Inner(count: 8), label: "x");
        return old_length;
    },
    );
    stdout.println(result);
}
