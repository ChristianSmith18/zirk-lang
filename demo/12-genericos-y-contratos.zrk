// DEMO 12 — Interfaces genéricas, implementaciones, despacho y protocolos de iteración.

import { stdout } from std.io;

interface Named<T> {
    value(): T;
}

record Tag implements Named<Int32> {
    value(): Int32 { return 7; }
}

class Box2 implements Named<Int32> {
    construct() { }
    value(): Int32 { return 9; }
}

fn show(n: Named<Int32>): Int32 { return n.value(); }

class Counter implements Iterable<Int32> {
    construct() { }
    iterator(): Iterator<Int32> { return CounterIt(); }
}
class CounterIt implements Iterator<Int32> {
    current: Int32;
    construct() { this.current = 0; }
    next(): Iteration<Int32> {
        if (this.current >= 3) { return Iteration.Done; }
        inmut v = this.current;
        this.current = this.current + 1;
        return Iteration.Item(value: v);
    }
}

fn main(): Void {
    inmut t = Tag();
    inmut b = Box2();
    stdout.println(t.value());
    stdout.println(show(b));
    for i in Counter() {
        stdout.println(i);
    }
    // `next()` se invoca mediante una variable tipada como `Iterator<Int32>`;
    // el contrato genérico determina el método que se ejecuta.
    inmut it: Iterator<Int32> = Counter().iterator();
    match it.next() {
        Iteration.Item(value) => stdout.println(value);
        Iteration.Done => stdout.println("done");
    }
}
