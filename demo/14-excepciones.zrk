// DEMO 14 — throws, throw, try/catch/finally y jerarquía Throwable.
// Esta muestra está tomada de una forma cubierta por el corpus ejecutable del compilador.

import { stdout } from std.io;

// Se muestran excepciones integradas y definidas por el usuario, captura por
// tipo concreto o por `Throwable`, ejecución de `finally` tanto en éxito como
// en error, propagación mediante `throws` y relanzamiento desde un `catch`.
class NetworkError implements Throwable {
    inmut reason: String;

    construct(reason: String) {
        this.reason = reason;
    }

    #override message(): String {
        return this.reason;
    }

    #override code(): String {
        return "NETWORK";
    }

    #override cause(): Error? {
        return null;
    }

    #override stack_trace(): StackTrace {
        return StackTrace();
    }
}

fn risky(fail: Boolean): Int32 throws NetworkError {
    if fail {
        throw NetworkError("connection lost");
    }
    return 42;
}

fn wrapper(fail: Boolean): Int32 throws NetworkError {
    try {
        return risky(fail);
    } catch NetworkError(e) {
        stdout.println("logging: " + e.message());
        throw;
    }
}

fn main(): Void {
    try {
        mut value: Int32 = risky(false);
        stdout.println(value);
    } catch NetworkError(error) {
        stdout.println(error.message());
    } finally {
        stdout.println("cleanup 1");
    }

    try {
        mut value: Int32 = risky(true);
        stdout.println(value);
    } catch NetworkError(error) {
        stdout.println(error.message());
    } finally {
        stdout.println("cleanup 2");
    }

    try {
        wrapper(true);
    } catch Throwable(e) {
        stdout.println("caught by supertype: " + e.message());
    }

    stdout.println("done");
}
