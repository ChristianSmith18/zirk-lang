// DEMO 20 — Literales con unidades y aritmética de Duration.

import { stdout } from std.io;

// Literales `Duration`, operaciones aritméticas, comparaciones e impresión.
fn main(): Void {
    stdout.println("units:", 500ns, 500us, 250ms, 2s, 90m, 1w);
    stdout.println("fractional:", 1.5s, 1.500000001s);
    stdout.println("arithmetic:", 1s + 500ms, 2s - 500ms, -250ms);
    stdout.println("scalar operations:", 2 * 250ms, 1s / 4, 1s * 2.5);
    // Dividir dos duraciones produce una razón Float64.
    stdout.println("ratio:", 1s / 250ms);
    stdout.println("comparisons:", 1s > 250ms, 1s == 1000ms, 500ms <= 500ms);

    // Conversión explícita e interpolación comparten el formato normalizado.
    inmut d = 1500ms;
    stdout.println(String(d));
    stdout.println("elapsed {1s + 500ms}");
    inmut neg = -1500ms;
    stdout.println("sign and magnitude:", neg.abs(), neg.sign(), neg.is_negative());
}
