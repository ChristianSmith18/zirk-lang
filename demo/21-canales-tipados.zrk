// DEMO 21 — Channel<T>, envío/recepción tipados, capacidad y cierre.
import { stdout } from std.io;

fn send_value(channel: Channel<Int32>): Void {
    channel.send(42);
}

// Canal tipado y acotado: creación, envío y recepción indirectos, y cierre
// idempotente. El tipo del canal determina el tipo de los valores enviados.
fn main(): Void {
    inmut channel: Channel<Int32> = Channel(1);
    concurrent {
        spawn send_value(channel);
    }
    inmut received = channel.receive();
    stdout.println(received);
    channel.close();
    stdout.println(channel.is_closed);
}
