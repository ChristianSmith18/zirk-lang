// DEMO 13 — Result<T,E>, construcción, consumo y match exhaustivo.
// Esta muestra está tomada de una forma cubierta por el corpus ejecutable del compilador.

import { stdout } from std.io;

// `Result<T,E>` representa un valor exitoso `Ok(...)` o un error `Error(...)`.
// El ejemplo muestra su construcción y análisis exhaustivo con `match`.
fn divide(a: Int32, b: Int32): Result<Int32, String> {
    if b == 0 {
        return Error("division by zero");
    }
    return Ok(Int32(a / b));
}

fn describe(r: Result<Int32, String>): String {
    return match r {
        Ok(value) => "ok:" + value.to_string();
        Error(error) => "error:" + error;
    };
}

fn main(): Void {
    // Explicit Result annotations preserve both variants for the later match.
    inmut ok: Result<Int32, String> = divide(10, 2);
    inmut error: Result<Int32, String> = divide(10, 0);

    stdout.println(describe(ok));
    stdout.println(describe(error));

    // Ordinary value use projects Ok(value) to value and every Error to null.
    // `??` therefore applies the fallback to every error, not only absence.
    stdout.println(ok ?? -1);
    stdout.println(error ?? -1);

    // Un `Result` debe analizarse o comprobarse. Si se quiere descartar de
    // forma deliberada, `_ = expresión;` expresa esa decisión.
    _ = divide(1, 0);
}
