// DEMO 28 — Región CPU paralela con división de trabajo sobre una colección.

import { stdout } from std.io;

// `Parallel.each` divide el cálculo entre workers y conserva el orden de la
// lista resultante. Después, `reduce` combina esos resultados.

fn main(): Void {
    inmut::strict values: List<Int32> = [1, 2, 3, 4, 5];
    inmut squares = Parallel.each(values, (value: Int32): Int32 => value * value);
    inmut sum = squares.parallel.reduce(0, (total: Int32, value: Int32): Int32 => total + value);
    stdout.println(sum);
}
