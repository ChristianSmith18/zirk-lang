// DEMO 05 — Funciones como valores, tipos Fn, lambdas, capturas y recursión.
// Esta muestra está tomada de una forma cubierta por el corpus ejecutable del compilador.

import { stdout } from std.io;

// Los tipos `Fn(...) => R` y `Function(...) => R` permiten guardar funciones
// en variables. Aquí se muestra una función con nombre, una closure que
// captura un valor y sobrevive a su función creadora, una lambda recursiva
// con tipo explícito y la comparación entre valores invocables con `is`.

fn double(n: Int32): Int32 {
    return n * 2;
}

fn triple(n: Int32): Int32 {
    return n * 3;
}

fn make_adder(step: Int32): Fn(Int32) => Int32 {
    return (n: Int32): Int32 => n + step;
}

fn main(): Void {
    inmut op: Fn(Int32) => Int32 = double;
    stdout.println(op(21));

    inmut add_five = make_adder(5);
    stdout.println(add_five(10));
    stdout.println(add_five(20));

    mut fact: Fn(Int32) => Int32 =(n: Int32): Int32 => n <= 1 ? 1 : n * fact(n - 1);
    stdout.println(fact(5));

    inmut a: Fn(Int32) => Int32 = double;
    inmut b: Fn(Int32) => Int32 = double;
    inmut c: Fn(Int32) => Int32 = triple;
    stdout.println(a is b);
    stdout.println(a is c);
}
