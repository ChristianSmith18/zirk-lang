// DEMO 10 — Casos con y sin payload, patrones exhaustivos y destructuración.

import { stdout } from std.io;

// Los enums con datos almacenan una etiqueta de variante y su contenido.
// Se pueden construir, reconocer mediante patrones, extraer sus valores y
// descartar campos con `_` dentro de un patrón comodín.
enum Shape {
    Circle(radius: Int32),
    Rect(width: Int32, height: Int32),
    Point
}

fn area(s: Shape): Int32 {
    return match s {
        Shape.Circle(radius) => radius * radius * 3,
        Shape.Rect(width, height) => width * height,
        Shape.Point => 0
    };
}

fn describe(s: Shape): String {
    return match s {
        Shape.Circle(_) => "circle",
        Shape.Rect(width, _) => "rect",
        _ => "other"
    };
}

fn main(): Void {
    // Los argumentos nombrados pueden cambiar de orden, igual que en una llamada normal.
    inmut circle = Shape.Circle(radius: 2);
    inmut rect = Shape.Rect(height: 4, width: 3);
    inmut point = Shape.Point;

    stdout.println(area(circle));
    stdout.println(area(rect));
    stdout.println(area(point));

    stdout.println(describe(circle));
    stdout.println(describe(rect));
    stdout.println(describe(point));
}
