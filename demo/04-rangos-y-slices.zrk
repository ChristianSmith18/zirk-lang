// DEMO 04 — Rangos abiertos/cerrados, pasos y recorrido de rangos.

import { stdout } from std.io;

fn main(): Void {
    stdout.println("half-open range 0..5");
    for i in 0 .. 5 {
        stdout.println(i);
    }
    stdout.println("step 2 over 0..10");
    for i in 0 .. 10: 2 {
        stdout.println(i);
    }
    stdout.println("closed range 0..=4");
    for i in 0 ..= 4 {
        stdout.println(i);
    }
    stdout.println("descending range 5..0");
    for i in 5 .. 0: -1 {
        stdout.println(i);
    }
    inmut r = 2 .. 9;
    stdout.println("range metadata:", r.start, r.end, r.step);
    stdout.println("descending range value");
    inmut rr = 8 .. 1: -1;
    for i in rr {
        stdout.println(i);
    }
    stdout.println("slice r[2:5]");
    for i in r[2: 5] {
        stdout.println(i);
    }
    stdout.println("slice r[::2]");
    for i in r[::2] {
        stdout.println(i);
    }
}
