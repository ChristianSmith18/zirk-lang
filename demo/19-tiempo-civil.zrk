// DEMO 19 — Date, Time, DateTime y validación de componentes temporales.

import { stdout } from std.io;

fn main(): Void {
    inmut d = Date(2026, 9, 6);
    stdout.println("date and components:", d, d.year, d.month, d.day);
    stdout.println(d + 2);
    stdout.println("month-end arithmetic:", Date(2026, 1, 31) + 2);
    stdout.println("date difference:", d - Date(2026, 9, 1));
    stdout.println("date ordering and equality:", d < Date(2026, 10, 1), d == Date(2026, 9, 6));
    inmut t = Time(14, 30, 45);
    stdout.println("time and components:", t, t.hour, t.minute, t.second);
    stdout.println(Time(23, 30) + 2h);
    stdout.println(Time(1, 0) - Time(23, 0));
    stdout.println("nanosecond precision:", Time(9, 5, 3, 123456789));
    inmut dt = DateTime(d, t);
    stdout.println("datetime, date, time, hour:", dt, dt.date, dt.time, dt.hour);
    stdout.println("combine date and time:", d + t);
    try {
        inmut bad = Date(2026, 2, 29);
        stdout.println(bad);
    } catch InvalidDateError(e) {
        stdout.println("invalid date:", e.code());
    }
    try {
        inmut bad = Time(25, 0);
        stdout.println(bad);
    } catch InvalidTimeError(e) {
        stdout.println("invalid time:", e.code());
    }
    inmut leap = Date(2024, 2, 29);
    stdout.println(leap);
}
