// DEMO 15 — Resource<E> y match with con cierre automático en las salidas.
// Esta muestra está tomada de una forma cubierta por el corpus ejecutable del compilador.

import { stdout } from std.io;

// Una clase puede implementar `Resource<E>` y devolver la adquisición como
// `Result<Recurso,E>`. La rama de `match ... with` que recibe el recurso se
// hace cargo de cerrarlo exactamente una vez, tanto al terminar normalmente
// como al salir temprano con `return`.
class OpenError implements Error {
    inmut reason: String;

    construct(reason: String) {
        this.reason = reason;
    }

    #override message(): String {
        return this.reason;
    }

    #override code(): String {
        return "OPEN";
    }

    #override cause(): Error? {
        return null;
    }
}

class FakeFile implements Resource<OpenError> {
    inmut name: String;
    mut closed: Boolean;

    construct(name: String) {
        this.name = name;
        this.closed = false;
    }

    read_all(): String {
        return "contents of " + this.name;
    }

    nothing(): Void {
        return;
    }

    #override close(): Result<Void, OpenError> {
        this.closed = true;
        stdout.println("closed " + this.name);
        return Ok(this.nothing());
    }

    #override is_closed(): Boolean {
        return this.closed;
    }
}

fn open_file(name: String, fail: Boolean): Result<FakeFile, OpenError> {
    if fail {
        return Error(OpenError("cannot open " + name));
    }
    return Ok(FakeFile(name));
}

    // Un `return` dentro de la rama que posee el recurso lo cierra antes de
    // abandonar la función.
fn read_then_return_early(name: String): Int32 {
    match open_file(name, false) with file {
        Ok(file) => {
            stdout.println(file.read_all());
            return 7;
        }
        Error(error) => {
            stdout.println(error.message());
        }
    }
    return -1;
}

fn main(): Void {
    // Flujo normal: adquirir, usar y cerrar.
    match open_file("users.json", false) with file {
        Ok(file) => {
            stdout.println(file.read_all());
        }
        Error(error) => {
            stdout.println("failed: " + error.message());
        }
    }

    // La rama de error no adquirió ningún recurso y no tiene nada que cerrar.
    match open_file("missing.json", true) with file {
        Ok(file) => {
            stdout.println(file.read_all());
        }
        Error(error) => {
            stdout.println("failed: " + error.message());
        }
    }

    stdout.println(read_then_return_early("early.txt"));

    stdout.println("done");
}
